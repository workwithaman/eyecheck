---
// Template for /schools, /clinics, /charity-support and /academic-collaboration (the AudienceTemplate artboard).
// Each page passes its own copy; sections without data are left out.
import Layout from '../layouts/Layout.astro';
import { routes } from '../data/site';

export interface Field {
	label: string;
	type?: 'text' | 'email' | 'tel' | 'url' | 'number' | 'textarea' | 'file';
	placeholder?: string;
	hint?: string;
	accept?: string;
	required?: boolean;
}

interface Props {
	crumb: string;
	h1: string;
	intro: string;
	image?: { src: string; alt: string; width: number; height: number };
	why?: { title: string; benefits?: { title: string; text: string }[]; listTitle?: string; list?: string[]; closing?: string };
	how?: { title: string; steps: string[] };
	plan?: { label: string; price: string; unit: string; items: string[] };
	resources?: { title: string };
	stories?: { title: string; text: string }[];
	faq: { title: string; questions: string[] };
	form: { fields: Field[]; consents?: string[]; button: string };
}

const p = Astro.props;
const slug = (s: string) =>
	s
		.toLowerCase()
		.replace(/\(.*?\)/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
---

<Layout title={`${p.h1} | EyeCheck.app`} active="orgs">
	<div class="inner">
		<div class="wrap crumb">Home › For organisations › {p.crumb}</div>
		<section class="wrap hero">
			<div class="hero-copy">
				<h1>{p.h1}</h1>
				<p class="muted">{p.intro}</p>
				<div class="actions">
					<a href="#contact" class="btn solid">Get started</a>
					<a href={routes.start} class="btn">Try the test yourself</a>
				</div>
			</div>
			{
				p.image ? (
					<img class="hero-img" src={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} />
				) : (
					<div class="ph hero-img">[Photo]</div>
				)
			}
		</section>

		{
			p.why && (
				<section class="sec band-2">
					<div class="wrap stack">
						<h2>{p.why.title}</h2>
						{p.why.benefits && (
							<div class="grid3">
								{p.why.benefits.map((b) => (
									<div class="card">
										<h3>{b.title}</h3>
										<p class="muted">{b.text}</p>
									</div>
								))}
							</div>
						)}
						{p.why.list && (
							<div class="card list-card">
								{p.why.listTitle && <h3>{p.why.listTitle}</h3>}
								<ul class="muted">
									{p.why.list.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</div>
						)}
						{p.why.closing && <p class="closing">{p.why.closing}</p>}
					</div>
				</section>
			)
		}

		{
			p.how && (
				<section class="sec">
					<div class="wrap narrow stack">
						<h2>{p.how.title}</h2>
						<div class="grid3">
							{p.how.steps.map((step, i) => (
								<div class="card">
									<span class="eyebrow">{i + 1}</span>
									<h3>{step}</h3>
								</div>
							))}
						</div>
					</div>
				</section>
			)
		}

		{
			p.plan && (
				<section class="sec band-2">
					<div class="wrap stack">
						<h2>Plans</h2>
						<div class="card plan">
							<span class="eyebrow">{p.plan.label}</span>
							<span class="price">{p.plan.price}</span>
							<span class="muted">{p.plan.unit}</span>
							<ul class="muted">
								{p.plan.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
							<a href="#contact" class="btn solid">
								Schedule an online session
							</a>
						</div>
					</div>
				</section>
			)
		}

		{
			p.resources && (
				<section class="sec">
					<div class="wrap stack">
						<h2>{p.resources.title}</h2>
						<div class="grid3">
							<a href={routes.chartPediatric} class="card">
								<h3>Pediatric eye chart</h3>
								<span class="note">Printable PDF for preschoolers</span>
							</a>
							<a href={routes.colorBlindKids} class="card">
								<h3>Color blind test for kids</h3>
								<span class="note">Shapes, from age 3</span>
							</a>
							<a href={routes.lazyEye} class="card">
								<h3>Lazy eye checklist</h3>
								<span class="note">Signs to look for in children</span>
							</a>
						</div>
					</div>
				</section>
			)
		}

		{
			p.stories && (
				<section class="sec band-2">
					<div class="wrap narrow stack">
						<h2>Success stories</h2>
						{p.stories.map((s) => (
							<div class="card">
								<h3>{s.title}</h3>
								<p class="muted">{s.text}</p>
							</div>
						))}
					</div>
				</section>
			)
		}

		<section class="sec">
			<div class="wrap narrow faq-list">
				<h2>{p.faq.title}</h2>
				{
					p.faq.questions.map((q) => (
						<div class="faq">
							<span>{q}</span>
							<span>+</span>
						</div>
					))
				}
			</div>
		</section>

		<section id="contact" class="sec band-2">
			<div class="wrap narrow">
				<!-- TODO: connect to the form endpoint for this page on the backend -->
				<form class="form">
					<h2>Talk to us</h2>
					<div class="fields">
						{
							p.form.fields.map((f) => {
								const name = slug(f.label);
								if (f.type === 'textarea')
									return (
										<label class="wide">
											{f.label}
											{f.hint && <span class="hint">{f.hint}</span>}
											<textarea name={name} required={f.required} />
										</label>
									);
								if (f.type === 'file')
									return (
										<label class="wide">
											{f.label}
											{f.hint && <span class="hint">{f.hint}</span>}
											<input type="file" name={name} accept={f.accept} multiple />
										</label>
									);
								return (
									<label>
										{f.label}
										<input type={f.type ?? 'text'} name={name} placeholder={f.placeholder} required={f.required} />
									</label>
								);
							})
						}
					</div>
					{
						p.form.consents?.map((c) => (
							<label class="check">
								<input type="checkbox" name={slug(c)} required />
								<span>{c}</span>
							</label>
						))
					}
					<button type="submit" class="btn solid">{p.form.button}</button>
				</form>
			</div>
		</section>
	</div>
</Layout>

<style>
	.hero {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 36px;
		padding-top: 20px;
		padding-bottom: 44px;
	}
	.hero-copy {
		flex: 1 1 460px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.hero-img {
		flex: 1 1 380px;
		min-width: 0;
		width: 100%;
		height: 300px;
		object-fit: cover;
		border-radius: 16px;
	}
	.band-2 {
		background: var(--surface-2);
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.card ul {
		margin: 0;
		padding-left: 18px;
		line-height: 1.7;
	}
	.list-card {
		background: var(--surface);
	}
	.closing {
		color: var(--ink);
		font-weight: 500;
	}
	.plan {
		max-width: 420px;
		border: 2px solid var(--blue);
	}
	.price {
		color: var(--ink);
		font-size: 40px;
		line-height: 46px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.plan .btn {
		align-self: flex-start;
		margin-top: 6px;
	}
	.faq-list h2 {
		margin-bottom: 12px;
	}
	.form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.fields {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}
	.fields label {
		flex: 1 1 240px;
	}
	.fields label.wide {
		flex-basis: 100%;
	}
	.hint {
		color: var(--muted);
		font-size: 13px;
		font-weight: 400;
	}
	.inner .check {
		flex-direction: row;
		align-items: flex-start;
		gap: 10px;
		font-weight: 400;
	}
	.inner .check input {
		min-height: 0;
		width: 18px;
		height: 18px;
		margin: 1px 0 0;
		padding: 0;
	}
	.inner input[type='file'] {
		padding: 9px 12px;
	}
	.form .btn {
		align-self: flex-start;
	}
</style>
