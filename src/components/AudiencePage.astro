---
// Template for /schools, /clinics, /charity-support and /academic-collaboration (the AudienceTemplate artboard).
// Each page passes its own copy; sections without data are left out.
// Forms without an endpoint are not connected to the backend yet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import { routes } from '../data/site';

export interface Field {
	label: string;
	name?: string;
	type?: 'text' | 'email' | 'tel' | 'url' | 'number' | 'textarea' | 'file' | 'select';
	placeholder?: string;
	hint?: string;
	accept?: string;
	required?: boolean;
	minLength?: number;
	autocomplete?: string;
	options?: string[];
}

export interface Faq {
	q: string;
	// May contain links (HTML). The plain-text version goes into the FAQPage schema.
	a?: string;
}

interface Props {
	slug: string;
	crumb: string;
	h1: string;
	intro: string;
	description?: string;
	// A string is served as-is from /public; an imported image is optimised to WebP by Astro.
	image?: { src: string | ImageMetadata; alt: string; width: number; height: number };
	why?: { title: string; benefits?: { title: string; text: string }[]; lists?: { title?: string; items: string[] }[]; closing?: string };
	how?: { title: string; steps: { title: string; text?: string }[] };
	plan?: { label: string; price: string; unit: string; items: string[] };
	resources?: { title: string; items: { title: string; href: string; note: string }[] };
	stories?: { title: string; text: string }[];
	faq: { title: string; items: Faq[] };
	// Adds a Service entry to the page's structured data.
	service?: { name: string; serviceType?: string; audience?: string; areaServed?: string; price?: string; currency?: string; offer?: string };
	form: {
		fields: Field[];
		consents?: string[];
		button: string;
		// Backend path (e.g. /email/school-form). Without one the form is not sent anywhere yet.
		endpoint?: string;
		success?: string;
	};
}

const p = Astro.props;
const slugify = (s: string) =>
	s
		.toLowerCase()
		.replace(/\(.*?\)/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
const plain = (html: string) => html.replace(/<[^>]+>/g, '');

const origin = Astro.site?.href ?? '/';
const pageUrl = new URL(`/${p.slug}/`, origin).href;
const answered = p.faq.items.filter((f) => f.a);
const graph: Record<string, unknown>[] = [
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', origin).href },
			// "For organisations" has no page of its own, so it appears in the visible breadcrumb only.
			{ '@type': 'ListItem', position: 2, name: p.crumb, item: pageUrl },
		],
	},
];
if (p.service)
	graph.push({
		'@type': 'Service',
		name: p.service.name,
		...(p.service.serviceType && { serviceType: p.service.serviceType }),
		url: pageUrl,
		provider: { '@type': 'Organization', name: 'EyeCheck.app', url: origin },
		...(p.service.audience && { audience: { '@type': 'Audience', audienceType: p.service.audience } }),
		...(p.service.areaServed && { areaServed: p.service.areaServed }),
		...(p.service.price && {
			offers: { '@type': 'Offer', price: p.service.price, priceCurrency: p.service.currency, description: p.service.offer },
		}),
	});
if (answered.length > 0)
	graph.push({
		'@type': 'FAQPage',
		mainEntity: answered.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a!) } })),
	});
const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<Layout title={`${p.h1} | EyeCheck.app`} description={p.description} active="orgs">
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	<div class="inner">
		<div class="wrap crumb">Home › For organisations › {p.crumb}</div>
		<section class="wrap hero">
			<div class="hero-copy">
				<h1>{p.h1}</h1>
				<p class="muted">{p.intro}</p>
				<div class="actions">
					<a href="#contact" class="btn solid">Get started</a>
					<a href={routes.start} class="btn">Try the test yourself</a>
				</div>
			</div>
			{
				p.image ? (
					typeof p.image.src === 'string' ? (
						<img class="hero-img" src={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} loading="eager" />
					) : (
						<Image class="hero-img" src={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} format="webp" loading="eager" />
					)
				) : (
					<div class="ph hero-img">[Photo]</div>
				)
			}
		</section>

		{
			p.why && (
				<section class="sec band-2">
					<div class="wrap stack">
						<h2>{p.why.title}</h2>
						{p.why.benefits && (
							<div class="grid3">
								{p.why.benefits.map((b) => (
									<div class="card">
										<h3>{b.title}</h3>
										<p class="muted">{b.text}</p>
									</div>
								))}
							</div>
						)}
						{p.why.lists && (
							<div class="lists">
								{p.why.lists.map((l) => (
									<div class="card list-card">
										{l.title && <h3>{l.title}</h3>}
										<ul class="muted">
											{l.items.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</div>
								))}
							</div>
						)}
						{p.why.closing && <p class="closing">{p.why.closing}</p>}
					</div>
				</section>
			)
		}

		{
			p.how && (
				<section class="sec">
					<div class="wrap narrow stack">
						<h2>{p.how.title}</h2>
						<div class="grid3">
							{p.how.steps.map((step, i) => (
								<div class="card">
									<span class="eyebrow">{i + 1}</span>
									<h3>{step.title}</h3>
									{step.text && <p class="step-text">{step.text}</p>}
								</div>
							))}
						</div>
					</div>
				</section>
			)
		}

		{
			p.plan && (
				<section class="sec band-2">
					<div class="wrap stack">
						<h2>Plans</h2>
						<div class="card plan">
							<span class="eyebrow">{p.plan.label}</span>
							<span class="price">{p.plan.price}</span>
							<span class="muted">{p.plan.unit}</span>
							<ul class="muted">
								{p.plan.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
							<a href="#contact" class="btn solid">
								Schedule an online session
							</a>
						</div>
					</div>
				</section>
			)
		}

		{
			p.resources && (
				<section class="sec">
					<div class="wrap stack">
						<h2>{p.resources.title}</h2>
						<div class="grid3">
							{p.resources.items.map((r) => (
								<a href={r.href} class="card">
									<h3>{r.title}</h3>
									<span class="note">{r.note}</span>
								</a>
							))}
						</div>
					</div>
				</section>
			)
		}

		{
			p.stories && (
				<section class="sec band-2">
					<div class="wrap narrow stack">
						<h2>Success stories</h2>
						{p.stories.map((s) => (
							<div class="card">
								<h3>{s.title}</h3>
								<p class="muted">{s.text}</p>
							</div>
						))}
					</div>
				</section>
			)
		}

		<section class="sec">
			<div class="wrap narrow faq-list">
				<h2>{p.faq.title}</h2>
				{
					p.faq.items.map((f) =>
						f.a ? (
							<details class="qa">
								<summary>
									<span>{f.q}</span>
									<span class="sign" aria-hidden="true" />
								</summary>
								<p set:html={f.a} />
							</details>
						) : (
							<div class="faq">
								<span>{f.q}</span>
								<span>+</span>
							</div>
						),
					)
				}
			</div>
		</section>

		<section id="contact" class="sec band-2">
			<div class="wrap narrow" data-form-wrap>
				<form class="form" novalidate={!!p.form.endpoint} data-endpoint={p.form.endpoint} data-success={p.form.success}>
					<h2>Talk to us</h2>
					<p class="required-note muted">Fields marked * are required.</p>
					<div class="fields">
						{
							p.form.fields.map((f) => {
								const name = f.name ?? slugify(f.label);
								const id = `f-${name}`;
								const describedBy = [f.hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ');
								const label = (
									<label for={id}>
										{f.label}
										{f.required && <span aria-hidden="true"> *</span>}
									</label>
								);
								const hint = f.hint && (
									<span class="hint" id={`${id}-hint`}>
										{f.hint}
									</span>
								);
								const error = <p class="error" id={`${id}-error`} hidden />;
								const common = { id, name, required: f.required, 'aria-required': f.required ? 'true' : undefined, 'aria-describedby': describedBy };
								let control;
								if (f.type === 'textarea') control = <textarea {...common} minlength={f.minLength} />;
								else if (f.type === 'select')
									control = (
										<select {...common}>
											<option value="" disabled selected>
												Select…
											</option>
											{f.options?.map((o) => (
												<option value={o}>{o}</option>
											))}
										</select>
									);
								else if (f.type === 'file') control = <input type="file" {...common} accept={f.accept} multiple />;
								else
									control = (
										<input
											type={f.type ?? 'text'}
											{...common}
											placeholder={f.placeholder}
											minlength={f.minLength}
											autocomplete={f.autocomplete}
										/>
									);
								const wide = f.type === 'textarea' || f.type === 'file';
								return (
									<div class:list={['field', { wide }]}>
										{label}
										{hint}
										{control}
										{error}
									</div>
								);
							})
						}
					</div>
					{
						p.form.consents?.map((c) => (
							<label class="check">
								<input type="checkbox" name={slugify(c)} required />
								<span>{c}</span>
							</label>
						))
					}
					<button type="submit" class="btn solid">{p.form.button}</button>
					<p class="form-error" role="alert" data-form-error hidden></p>
				</form>
			</div>
		</section>
	</div>
</Layout>

<script>
	import { BACKEND_URL } from '../data/backend';

	// Only forms with an endpoint are sent; the others stay as static layouts for now.
	document.querySelectorAll<HTMLFormElement>('form[data-endpoint]').forEach((form) => {
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const label = button.textContent ?? '';
		const formError = form.querySelector<HTMLElement>('[data-form-error]')!;
		type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
		const controls = [...form.querySelectorAll<Control>('input, select, textarea')];

		const messageFor = (el: Control) => {
			const name = (el.labels?.[0]?.textContent ?? 'this field').replace('*', '').replace(/\(.*?\)/, '').trim().toLowerCase();
			if (el.validity.valueMissing) return el instanceof HTMLSelectElement ? `Choose a ${name}.` : `Enter the ${name}.`;
			if (el.validity.typeMismatch) return 'Enter a valid email address, like name@school.edu.';
			if (el.validity.tooShort) return `Enter at least ${(el as HTMLInputElement).minLength} characters.`;
			return el.validationMessage;
		};
		const check = (el: Control) => {
			const box = form.querySelector<HTMLElement>(`#${el.id}-error`);
			const ok = el.checkValidity();
			el.setAttribute('aria-invalid', String(!ok));
			if (box) {
				box.hidden = ok;
				box.textContent = ok ? '' : messageFor(el);
			}
			return ok;
		};

		controls.forEach((el) => {
			el.addEventListener('blur', () => el.value && check(el));
			el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && check(el));
		});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			formError.hidden = true;
			const invalid = controls.filter((el) => !check(el));
			if (invalid.length > 0) {
				invalid[0].focus();
				return;
			}
			button.disabled = true;
			button.textContent = 'Sending…';
			try {
				const res = await fetch(BACKEND_URL + form.dataset.endpoint, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(Object.fromEntries(new FormData(form))),
				});
				// Any non-2xx, including 429 from the rate limiter, shows the same message.
				if (!res.ok) throw new Error(`HTTP ${res.status}`);
				const done = document.createElement('p');
				done.className = 'form-done';
				done.setAttribute('role', 'status');
				done.textContent = form.dataset.success ?? 'Thanks! We’ll be in touch soon.';
				form.replaceWith(done);
			} catch (err) {
				console.error('Form not sent:', err);
				formError.textContent = 'Sorry, something went wrong. Please try again or email support@eyecheck.app.';
				formError.hidden = false;
				button.disabled = false;
				button.textContent = label;
			}
		});
	});
</script>

<style>
	.hero {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 36px;
		padding-top: 20px;
		padding-bottom: 44px;
	}
	.hero-copy {
		flex: 1 1 460px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.hero-img {
		flex: 1 1 380px;
		min-width: 0;
		width: 100%;
		height: 300px;
		object-fit: cover;
		border-radius: 16px;
	}
	.band-2 {
		background: var(--surface-2);
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.card ul {
		margin: 0;
		padding-left: 18px;
		line-height: 1.7;
	}
	.lists {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: 24px;
	}
	.list-card {
		background: var(--surface);
	}
	.closing {
		color: var(--ink);
		font-weight: 500;
	}
	.step-text {
		color: var(--slate);
		font-size: 15px;
		line-height: 24px;
	}
	.plan {
		max-width: 420px;
		border: 2px solid var(--blue);
	}
	.price {
		color: var(--ink);
		font-size: 40px;
		line-height: 46px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.plan .btn {
		align-self: flex-start;
		margin-top: 6px;
	}
	.faq-list h2 {
		margin-bottom: 12px;
	}
	.qa {
		border-bottom: 1px solid var(--line);
	}
	.qa summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 18px 0;
		font-weight: 600;
		list-style: none;
		cursor: pointer;
	}
	.qa summary::-webkit-details-marker {
		display: none;
	}
	.sign::before {
		content: '+';
		color: var(--blue);
		font-size: 20px;
		font-weight: 600;
	}
	.qa[open] .sign::before {
		content: '−';
	}
	.qa p {
		padding-bottom: 18px;
		font-size: 15px;
		line-height: 24px;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.required-note {
		margin-top: -8px;
		font-size: 14px;
	}
	.fields {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}
	.field {
		/* Two per row on desktop, so a long label never pushes its input below its neighbours. */
		flex: 1 1 280px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}
	.field.wide {
		flex-basis: 100%;
	}
	.inner .field label {
		display: block;
		color: var(--ink);
	}
	.inner .field select {
		width: 100%;
		min-height: 44px;
		padding: 0 12px;
		border: 1px solid var(--muted);
		border-radius: 6px;
		background: var(--surface);
		color: var(--ink);
		font: inherit;
	}
	.inner .field input,
	.inner .field textarea {
		width: 100%;
		box-sizing: border-box;
	}
	.field [aria-invalid='true'] {
		border-color: var(--ink);
		outline: 1px solid var(--ink);
	}
	.hint {
		color: var(--muted);
		font-size: 13px;
		line-height: 18px;
	}
	.error,
	.form-error {
		margin: 0;
		color: var(--ink);
		font-size: 13px;
		line-height: 18px;
		font-weight: 500;
	}
	.error::before,
	.form-error::before {
		content: '! ';
		color: var(--blue);
		font-weight: 700;
	}
	.form-error {
		font-size: 15px;
	}
	.inner .check {
		flex-direction: row;
		align-items: flex-start;
		gap: 10px;
		font-weight: 400;
	}
	.inner .check input {
		min-height: 0;
		width: 18px;
		height: 18px;
		margin: 1px 0 0;
		padding: 0;
	}
	.inner input[type='file'] {
		padding: 9px 12px;
	}
	.form .btn {
		align-self: flex-start;
	}
	:global(.form-done) {
		padding: 20px 22px;
		border-radius: 14px;
		background: var(--lens);
		color: var(--ink);
		font-size: 17px;
		font-weight: 500;
	}
</style>
