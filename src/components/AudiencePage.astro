---
// Template for /schools, /clinics, /charity-support and /academic-collaboration (the AudienceTemplate artboard).
// Each page passes its own copy; sections without data are left out.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import ApiForm, { type Props as FormProps } from './ApiForm.astro';
import FaqItem from './FaqItem.astro';
import { routes } from '../data/site';


export interface Faq {
	q: string;
	// May contain links (HTML). The plain-text version goes into the FAQPage schema.
	a?: string;
}

interface Props {
	slug: string;
	crumb: string;
	h1: string;
	intro: string;
	description?: string;
	// A string is served as-is from /public; an imported image is optimised to WebP by Astro.
	image?: { src: string | ImageMetadata; alt: string; width: number; height: number };
	why?: { title: string; intro?: string; benefits?: { title: string; text: string }[]; lists?: { title?: string; items: string[] }[]; closing?: string };
	// wide: full-width container so three steps fit on one row. callout: highlighted line (and link) after the steps.
	how?: { title: string; wide?: boolean; steps: { title: string; text?: string }[]; callout?: string; link?: { text: string; href: string } };
	plan?: { label: string; price: string; unit: string; items: string[] };
	resources?: { title: string; items: { title: string; href: string; note: string }[] };
	stories?: { title: string; text: string }[];
	faq: { title: string; items: Faq[] };
	// Adds a Service entry to the page's structured data.
	service?: { name: string; serviceType?: string; audience?: string; areaServed?: string; price?: string; currency?: string; offer?: string };
	form: FormProps;
}

const p = Astro.props;
const slugify = (s: string) =>
	s
		.toLowerCase()
		.replace(/\(.*?\)/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
const plain = (html: string) => html.replace(/<[^>]+>/g, '');

const origin = Astro.site?.href ?? '/';
const pageUrl = new URL(`/${p.slug}/`, origin).href;
const answered = p.faq.items.filter((f) => f.a);
const graph: Record<string, unknown>[] = [
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', origin).href },
			// "For organisations" has no page of its own, so it appears in the visible breadcrumb only.
			{ '@type': 'ListItem', position: 2, name: p.crumb, item: pageUrl },
		],
	},
];
if (p.service)
	graph.push({
		'@type': 'Service',
		name: p.service.name,
		...(p.service.serviceType && { serviceType: p.service.serviceType }),
		url: pageUrl,
		provider: { '@type': 'Organization', name: 'EyeCheck.app', url: origin },
		...(p.service.audience && { audience: { '@type': 'Audience', audienceType: p.service.audience } }),
		...(p.service.areaServed && { areaServed: p.service.areaServed }),
		...(p.service.price && {
			offers: { '@type': 'Offer', price: p.service.price, priceCurrency: p.service.currency, description: p.service.offer },
		}),
	});
if (answered.length > 0)
	graph.push({
		'@type': 'FAQPage',
		mainEntity: answered.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a!) } })),
	});
const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<Layout title={`${p.h1} | EyeCheck.app`} description={p.description} active="orgs">
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	<div class="inner">
		<div class="wrap crumb">Home › For organisations › {p.crumb}</div>
		<section class="wrap hero">
			<div class="hero-copy">
				<h1>{p.h1}</h1>
				<p class="muted">{p.intro}</p>
				<div class="actions">
					<a href="#contact" class="btn solid">Get started</a>
					<a href={routes.start} class="btn">Try the test yourself</a>
				</div>
			</div>
			{
				p.image ? (
					typeof p.image.src === 'string' ? (
						<img class="hero-img" src={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} loading="eager" />
					) : (
						<Image class="hero-img" src={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} format="webp" loading="eager" />
					)
				) : (
					<div class="ph hero-img">[Photo]</div>
				)
			}
		</section>

		{
			p.why && (
				<section class="sec band-2">
					<div class="wrap stack">
						<h2>{p.why.title}</h2>
						{p.why.intro && <p class="section-intro">{p.why.intro}</p>}
						{p.why.benefits && (
							<div class="grid3">
								{p.why.benefits.map((b) => (
									<div class="card">
										<h3>{b.title}</h3>
										<p class="muted">{b.text}</p>
									</div>
								))}
							</div>
						)}
						{p.why.lists && (
							<div class="lists">
								{p.why.lists.map((l) => (
									<div class="card list-card">
										{l.title && <h3>{l.title}</h3>}
										<ul class="muted">
											{l.items.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</div>
								))}
							</div>
						)}
						{p.why.closing && <p class="closing">{p.why.closing}</p>}
					</div>
				</section>
			)
		}

		{
			p.how && (
				<section class="sec">
					<div class:list={['wrap stack', { narrow: !p.how.wide }]}>
						<h2>{p.how.title}</h2>
						<div class="grid3">
							{p.how.steps.map((step, i) => (
								<div class="card">
									<span class="eyebrow">{i + 1}</span>
									<h3>{step.title}</h3>
									{step.text && <p class="step-text">{step.text}</p>}
								</div>
							))}
						</div>
						{p.how.callout && <blockquote class="callout">{p.how.callout}</blockquote>}
						{p.how.link && (
							<a href={p.how.link.href} class="more-link">
								{p.how.link.text} →
							</a>
						)}
					</div>
				</section>
			)
		}

		{
			p.plan && (
				<section class="sec band-2">
					<div class="wrap stack">
						<h2>Plans</h2>
						<div class="card plan">
							<span class="eyebrow">{p.plan.label}</span>
							<span class="price">{p.plan.price}</span>
							<span class="muted">{p.plan.unit}</span>
							<ul class="muted">
								{p.plan.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
							<a href="#contact" class="btn solid">
								Schedule an online session
							</a>
						</div>
					</div>
				</section>
			)
		}

		{
			p.resources && (
				<section class="sec">
					<div class="wrap stack">
						<h2>{p.resources.title}</h2>
						<div class="grid3">
							{p.resources.items.map((r) => (
								<a href={r.href} class="card">
									<h3>{r.title}</h3>
									<span class="note">{r.note}</span>
								</a>
							))}
						</div>
					</div>
				</section>
			)
		}

		{
			p.stories && (
				<section class="sec band-2">
					<div class="wrap narrow stack">
						<h2>Success stories</h2>
						{p.stories.map((s) => (
							<div class="card">
								<h3>{s.title}</h3>
								<p class="muted">{s.text}</p>
							</div>
						))}
					</div>
				</section>
			)
		}

		<section class="sec">
			<div class="wrap narrow faq-list">
				<h2>{p.faq.title}</h2>
				{
					p.faq.items.map((f) =>
						f.a ? (
							<FaqItem q={f.q} a={f.a} />
						) : (
							<div class="faq">
								<span>{f.q}</span>
								<span>+</span>
							</div>
						),
					)
				}
			</div>
		</section>

		<section id="contact" class="sec band-2">
			<div class="wrap narrow" data-form-wrap>
				<ApiForm {...p.form} />
			</div>
		</section>
	</div>
</Layout>


<style>
	.hero {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 36px;
		padding-top: 20px;
		padding-bottom: 44px;
	}
	.hero-copy {
		flex: 1 1 460px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.hero-img {
		flex: 1 1 380px;
		min-width: 0;
		width: 100%;
		height: 300px;
		object-fit: cover;
		border-radius: 16px;
	}
	.band-2 {
		background: var(--surface-2);
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.card ul {
		margin: 0;
		padding-left: 18px;
		line-height: 1.7;
	}
	.lists {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: 24px;
	}
	.list-card {
		background: var(--surface);
	}
	.closing {
		color: var(--ink);
		font-weight: 500;
	}
	.section-intro {
		max-width: 720px;
		color: var(--slate);
		font-size: 17px;
		line-height: 27px;
	}
	.callout {
		margin: 8px 0 0;
		padding: 20px 24px;
		border-left: 0;
		border-radius: 16px;
		background: var(--lens);
		color: var(--ink);
		font-size: 19px;
		line-height: 28px;
		font-weight: 500;
	}
	.more-link {
		align-self: flex-start;
		font-weight: 600;
		text-decoration: none;
	}
	.step-text {
		color: var(--slate);
		font-size: 15px;
		line-height: 24px;
	}
	.plan {
		max-width: 420px;
		border: 2px solid var(--blue);
	}
	.price {
		color: var(--ink);
		font-size: 40px;
		line-height: 46px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.plan .btn {
		align-self: flex-start;
		margin-top: 6px;
	}
	.faq-list h2 {
		margin-bottom: 12px;
	}

</style>
