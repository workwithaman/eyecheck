---
import { site, routes, tests, charts, orgs } from '../data/site';

interface Props {
	active?: 'tests' | 'charts' | 'orgs' | 'blog' | 'about' | '';
}

const { active = '' } = Astro.props;
// Marks the Donate buttons as the current page on /donation/.
const onDonation = Astro.url.pathname === routes.donation;
const heart = 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z';
---

<div class="trust">
	<div class="wrap trust-in">
		<div class="trust-items">
			<span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>Free, no app to download</span>
			<span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>{site.peopleScreened} people screened</span>
		</div>
		<div class="trust-links"><a href={routes.schools}>For schools</a><a href={routes.help}>Help</a></div>
	</div>
</div>

<header class="site-header" data-header>
	<div class="wrap bar">
		<a href={routes.home} class="logo" aria-label="EyeCheck home">
			<img src="/images/logo.svg" alt="EyeCheck" width="1103" height="160" />
		</a>

		<nav aria-label="Main" class="nav" id="main-nav">
			<div class="item wide" data-menu>
				<button type="button" class:list={['link', { current: active === 'tests' }]} aria-expanded="false" aria-controls="menu-tests">
					Eye tests<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
				</button>
				<div class="drop" id="menu-tests">
					<div class="sheet">
						<span class="caret"></span>
						<div class="body split">
							<div class="grid">
								{
									tests.map((t) => (
										<a href={t.href} class="entry">
											<span class:list={['tile', { kids: t.kids }]}>
												<img src={t.img} alt="" width="42" height="29" loading="lazy" />
											</span>
											<span class="text">
												<b>{t.title}</b>
												<span>{t.menu}</span>
											</span>
										</a>
									))
								}
							</div>
							<div class="promo">
								<span class="eyebrow">Most popular</span>
								<b>Full online eye test</b>
								<span>Both eyes, about 5 minutes, results you can download.</span>
								<a href={routes.start} class="promo-btn">
									Start free eye test<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
								</a>
							</div>
						</div>
						<div class="foot">
							<a href={`${routes.home}#tests`}>All eye tests →</a>
							<a href={routes.howWeTest} class="quiet">How we test</a>
						</div>
					</div>
				</div>
			</div>

			<div class="item charts" data-menu>
				<button type="button" class:list={['link', { current: active === 'charts' }]} aria-expanded="false" aria-controls="menu-charts">
					Eye charts<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
				</button>
				<div class="drop" id="menu-charts">
					<div class="sheet">
						<span class="caret"></span>
						<div class="body">
							{
								charts.map((c) => (
									<a href={c.href} class="entry">
										<span class:list={['tile', { kids: c.kids }]}>
											<img src={c.img} alt="" width="42" height="29" loading="lazy" />
										</span>
										<span class="text">
											<b>{c.title}</b>
											<span>{c.menu}</span>
										</span>
										<span class="pdf">PDF</span>
									</a>
								))
							}
						</div>
						<div class="foot">
							<a href={routes.eyeCharts}>All printable charts →</a>
							<span class="aside">Letter + A4</span>
						</div>
					</div>
				</div>
			</div>

			<div class="item orgs" data-menu>
				<button type="button" class:list={['link', { current: active === 'orgs' }]} aria-expanded="false" aria-controls="menu-orgs">
					For organisations<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
				</button>
				<div class="drop" id="menu-orgs">
					<div class="sheet">
						<span class="caret"></span>
						<div class="body">
							{
								orgs.map((o) => (
									<a href={o.href} class="entry">
										<span class="icon">
											<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={o.icon} />
										</span>
										<span class="text">
											<b>{o.menuTitle}</b>
											<span>{o.menu}</span>
										</span>
									</a>
								))
							}
						</div>
						<div class="foot">
							<a href={routes.donation}>Support our work: Donate →</a>
						</div>
					</div>
				</div>
			</div>

			<a href={routes.blog} class:list={['link', { current: active === 'blog' }]}>Blog</a>
			<a href={routes.about} class:list={['link', { current: active === 'about' }]}>About</a>

			<div class="nav-cta">
				<a href={routes.start} class="btn solid">Start free eye test</a>
				<a href={routes.donation} class="donate" data-cta="header-donate" aria-current={onDonation ? 'page' : undefined}>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={heart} /></svg>
					Donate
				</a>
			</div>
		</nav>

		<div class="ctas">
			{/* Desktop only; on mobile Donate sits in the open menu, under Start free eye test. */}
			<a href={routes.donation} class="donate" data-cta="header-donate" aria-current={onDonation ? 'page' : undefined}>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={heart} /></svg>
				Donate
			</a>
			<a href={routes.start} class="btn solid cta">
				<span class="long">Start free eye test</span><span class="short">Start test</span>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
			</a>
		</div>

		<button type="button" class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav" data-burger>
			<svg class="i-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			<svg class="i-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
		</button>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	if (header) {
		const items = [...header.querySelectorAll<HTMLElement>('[data-menu]')];
		const burger = header.querySelector<HTMLButtonElement>('[data-burger]');
		// Hover only drives the menus on the desktop bar with a real pointer.
		const hoverable = window.matchMedia('(hover: hover) and (min-width: 1180px)');
		let timer: number | undefined;

		const setOpen = (item: HTMLElement, open: boolean) => {
			item.classList.toggle('open', open);
			item.querySelector('button')?.setAttribute('aria-expanded', String(open));
		};
		const closeAll = (except?: HTMLElement) => items.forEach((i) => i !== except && setOpen(i, false));
		const setMobile = (open: boolean) => {
			header.classList.toggle('menu-open', open);
			burger?.setAttribute('aria-expanded', String(open));
			burger?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		};

		items.forEach((item) => {
			item.querySelector('button')?.addEventListener('click', () => {
				window.clearTimeout(timer);
				const open = !item.classList.contains('open');
				closeAll(item);
				setOpen(item, open);
			});
			item.addEventListener('mouseenter', () => {
				if (!hoverable.matches) return;
				window.clearTimeout(timer);
				timer = window.setTimeout(() => {
					closeAll(item);
					setOpen(item, true);
				}, 120);
			});
			item.addEventListener('mouseleave', () => {
				if (!hoverable.matches) return;
				window.clearTimeout(timer);
				timer = window.setTimeout(() => setOpen(item, false), 200);
			});
			// Tabbing out of the panel closes it; the mobile accordion stays as the visitor left it.
			item.addEventListener('focusout', (e) => {
				if (hoverable.matches && !item.contains(e.relatedTarget as Node | null)) setOpen(item, false);
			});
		});

		burger?.addEventListener('click', () => setMobile(!header.classList.contains('menu-open')));

		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			window.clearTimeout(timer);
			const open = items.find((i) => i.classList.contains('open'));
			if (open) {
				setOpen(open, false);
				open.querySelector('button')?.focus();
			} else if (header.classList.contains('menu-open')) {
				setMobile(false);
				burger?.focus();
			}
		});

		document.addEventListener('click', (e) => {
			if (!header.contains(e.target as Node)) closeAll();
		});
	}
</script>

<style>
	.trust {
		background: var(--lens);
		font-size: 13px;
		line-height: 20px;
		font-weight: 500;
	}
	.trust-in {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 6px 24px;
		padding-top: 8px;
		padding-bottom: 8px;
	}
	.trust-items {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 20px;
	}
	.trust-items span {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.trust-items svg {
		color: var(--green);
	}
	.trust-links {
		display: flex;
		gap: 18px;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.bar {
		position: relative;
		display: flex;
		align-items: center;
		/* Gaps and logo size leave room for Donate + Start free eye test without shrinking either button. */
		gap: 24px;
		height: 72px;
	}
	.logo {
		display: flex;
		flex: 0 0 auto;
	}
	.logo img {
		display: block;
		height: 34px;
		width: auto;
	}

	.nav {
		display: flex;
		flex: 1;
		gap: 18px;
		height: 100%;
		font-size: 15px;
	}
	.item {
		position: relative;
		display: flex;
	}
	/* The wide panel is placed against the bar, so it can be clamped inside the page. */
	.item.wide {
		position: static;
	}
	.link {
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 0;
		border: 0;
		border-top: 3px solid transparent;
		border-bottom: 3px solid transparent;
		background: none;
		color: var(--ink);
		font: inherit;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
	}
	.link:hover,
	.item.open > .link {
		color: var(--blue);
	}
	.link.current {
		border-bottom-color: var(--blue);
		color: var(--blue);
		font-weight: 600;
	}
	.link svg {
		transition: transform 0.15s;
	}
	.item.open > .link svg {
		transform: rotate(180deg);
	}

	/* Dropdown: sits 14px below the bar; the padding keeps the pointer inside on the way down. */
	.drop {
		position: absolute;
		top: 100%;
		left: -14px;
		z-index: 60;
		padding-top: 14px;
		visibility: hidden;
		opacity: 0;
		transform: translateY(-4px);
		transition:
			opacity 0.15s,
			transform 0.15s,
			visibility 0s 0.15s;
	}
	.item.open > .drop {
		visibility: visible;
		opacity: 1;
		transform: none;
		transition-delay: 0s;
	}
	.item.wide > .drop {
		left: max(20px, min(190px, calc(100% - 800px)));
	}
	.sheet {
		position: relative;
		width: 380px;
		border: 1px solid var(--line);
		border-radius: 20px;
		background: var(--surface);
		box-shadow:
			0 24px 56px rgba(16, 24, 40, 0.14),
			0 2px 6px rgba(16, 24, 40, 0.05);
	}
	.wide .sheet {
		width: 780px;
	}
	.orgs .sheet {
		width: 420px;
	}
	.caret {
		position: absolute;
		top: -7px;
		left: 44px;
		width: 14px;
		height: 14px;
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
		background: var(--surface);
		transform: rotate(45deg);
	}
	.orgs .caret {
		left: 74px;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 12px;
	}
	.body.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 236px;
		gap: 8px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2px 4px;
		align-content: start;
	}
	.entry {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px;
		border-radius: 14px;
		color: var(--ink);
		text-decoration: none;
	}
	.entry:hover {
		background: var(--surface-2);
	}
	.entry:hover b {
		color: var(--blue);
	}
	.entry:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 2px;
	}
	.tile,
	.icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 48px;
		overflow: hidden;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: var(--lens);
	}
	.tile.kids {
		background: var(--sun-soft);
	}
	.tile img {
		display: block;
		width: 42px;
		height: auto;
	}
	.icon {
		flex-basis: 44px;
		width: 44px;
		height: 44px;
		border-radius: 22px;
		color: var(--blue);
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.text b {
		font-size: 15px;
		line-height: 20px;
		font-weight: 600;
	}
	.text span {
		color: var(--slate);
		font-size: 13px;
		line-height: 18px;
	}
	.pdf {
		flex: 0 0 auto;
		margin-left: auto;
		padding: 3px 9px;
		border-radius: 999px;
		background: var(--lens);
		color: var(--blue);
		font-size: 11px;
		line-height: 16px;
		font-weight: 600;
	}

	.promo {
		align-self: start;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 20px;
		border-radius: 14px;
		background: var(--lens);
	}
	.promo .eyebrow {
		font-size: 11px;
	}
	.promo > b {
		font-size: 18px;
		line-height: 24px;
		font-weight: 600;
	}
	.promo > span:not(.eyebrow) {
		color: var(--slate);
		font-size: 13px;
		line-height: 19px;
	}
	.promo-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 44px;
		margin-top: 6px;
		border-radius: 999px;
		background: var(--blue);
		color: var(--on-blue);
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
	}
	.promo-btn:hover {
		background: var(--blue-strong);
		color: var(--on-blue);
	}

	.foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 12px 20px;
		border-top: 1px solid var(--line);
		border-radius: 0 0 19px 19px;
		background: var(--surface-2);
		font-size: 14px;
		line-height: 20px;
		font-weight: 500;
	}
	.foot a {
		text-decoration: none;
	}
	.foot .quiet {
		color: var(--slate);
	}
	.foot .aside {
		color: var(--muted);
		font-size: 13px;
	}

	.ctas {
		flex: 0 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
	}
	.cta {
		flex: 0 0 auto;
		min-height: 46px;
		padding: 0 22px;
	}
	/* Secondary (outline) button, the same height as Start free eye test. */
	.donate {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 46px;
		padding: 0 20px;
		border: 1.5px solid var(--lens-line);
		border-radius: var(--radius-pill);
		background: var(--surface);
		color: var(--blue);
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.donate:hover {
		background: var(--lens);
	}
	.link:focus-visible,
	.donate:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 2px;
	}
	.short,
	.nav-cta,
	.burger {
		display: none;
	}

	@media (max-width: 1279px) {
		/* The wide panel is clamped to the page here, so it no longer lines up with its trigger. */
		.wide .caret {
			display: none;
		}
	}

	/* Below 1180px the nav becomes an accordion; panels turn into plain link lists. The desktop row (nav, Donate and
	   Start free eye test) needs about 1150px, so tablets get the compact bar with the menu button. */
	@media (max-width: 1179px) {
		.trust-items span:nth-child(n + 2),
		.trust-links {
			display: none;
		}
		.bar {
			justify-content: space-between;
			gap: 2px;
			height: 60px;
			padding-right: 10px;
		}
		.logo {
			margin-right: auto;
		}
		.logo img {
			height: 30px;
		}
		.cta {
			min-height: 44px;
			padding: 0 16px;
			font-size: 14px;
		}
		.cta svg,
		.long,
		.ctas .donate {
			display: none;
		}
		.short {
			display: inline;
		}
		.burger {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 44px;
			height: 44px;
			padding: 0;
			border: 0;
			background: none;
			color: var(--ink);
			cursor: pointer;
		}
		.i-close,
		.menu-open .i-open {
			display: none;
		}
		.menu-open .i-close {
			display: block;
		}

		.nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			gap: 0;
			height: auto;
			max-height: calc(100dvh - 60px);
			overflow-y: auto;
			border-bottom: 1px solid var(--line);
			background: var(--surface);
			font-size: 16px;
			box-shadow: 0 16px 40px rgba(16, 24, 40, 0.08);
		}
		.menu-open .nav {
			display: flex;
		}
		.item {
			flex-direction: column;
		}
		.link {
			justify-content: space-between;
			width: 100%;
			padding: 14px 18px;
			border: 0;
			border-bottom: 1px solid var(--line);
			font-weight: 600;
		}
		.link.current {
			border-bottom-color: var(--line);
		}

		.drop,
		.item.wide > .drop {
			display: none;
			position: static;
			padding: 0;
			visibility: visible;
			opacity: 1;
			transform: none;
			transition: none;
		}
		.item.open > .drop {
			display: block;
		}
		.sheet,
		.wide .sheet,
		.orgs .sheet {
			width: auto;
			border: 0;
			border-bottom: 1px solid var(--line);
			border-radius: 0;
			background: var(--surface-2);
			box-shadow: none;
		}
		.body,
		.body.split,
		.grid {
			display: block;
			padding: 0;
		}
		.body {
			padding: 4px 18px 0;
		}
		.entry {
			display: block;
			padding: 8px 0;
			border-radius: 0;
		}
		.text b {
			font-weight: 400;
		}
		.caret,
		.tile,
		.icon,
		.pdf,
		.promo,
		.text span,
		.foot .quiet,
		.foot .aside {
			display: none;
		}
		.foot {
			padding: 8px 18px 12px;
			border: 0;
