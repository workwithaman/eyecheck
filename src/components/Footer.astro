---
import { site, routes, footerColumns, legalLinks } from '../data/site';

const year = new Date().getFullYear();
const socials = [
	{ name: 'YouTube', href: site.social.youtube, icon: '<rect x="3" y="6" width="18" height="12" rx="3"></rect><path d="M10 9.5l4.5 2.5-4.5 2.5z"></path>' },
	{ name: 'Instagram', href: site.social.instagram, icon: '<rect x="4" y="4" width="16" height="16" rx="4"></rect><circle cx="12" cy="12" r="3.5"></circle>' },
	{ name: 'LinkedIn', href: site.social.linkedin, icon: '<rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M8 10v6M8 7.5v.01M12 16v-6M12 13c0-2 4-2.5 4 0v3"></path>' },
].filter((s) => s.href);
---

<footer>
	<div class="reminder">
		<div class="wrap reminder-in">
			<div class="pitch">
				<img src="/images/test-reading-glasses.svg" alt="" width="96" height="66" loading="lazy" />
				<div>
					<b>Get a reminder to re-check your eyes</b>
					<span>One email in 12 months. Nothing else. Unsubscribe any time.</span>
				</div>
			</div>
			<!-- TODO: point this form at the reminder signup endpoint -->
			<form>
				<label>
					Email address
					<input type="email" name="email" autocomplete="email" required />
				</label>
				<button type="submit" class="btn solid">Remind me</button>
			</form>
		</div>
	</div>

	<div class="wrap main">
		<div class="top">
			<div class="brand">
				<a href={routes.home} aria-label="EyeCheck home" class="logo">
					<img src="/images/logo-white.svg" alt="EyeCheck" width="607" height="232" loading="lazy" />
				</a>
				<span>Free vision screening anyone can use, so eye problems are caught early.</span>
				<a href={routes.medicalReview} class="reviewed">
					<span class="avatar"></span>
					<span class="who">
						<b>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ADE80" stroke-width="2.8" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
							Medically reviewed
						</b>
						<span>by {site.reviewer}</span>
					</span>
				</a>
				{
					socials.length > 0 && (
						<div class="socials">
							{socials.map((s) => (
								<a href={s.href} aria-label={`EyeCheck on ${s.name}`}>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={s.icon} />
								</a>
							))}
						</div>
					)
				}
			</div>
			<nav aria-label="Footer" class="cols">
				{
					footerColumns.map((col) => (
						<div>
							<b>{col.title}</b>
							{col.links.map((l) => (
								<a href={l.href}>{l.title}</a>
							))}
						</div>
					))
				}
			</nav>
		</div>

		<div class="disclaimer">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7AA7FF" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16v.01"></path></svg>
			<p>
				EyeCheck is a vision screening tool. It does not diagnose eye conditions or replace a full eye exam by an optometrist or
				ophthalmologist. If you notice sudden changes in your vision, seek care straight away.
			</p>
		</div>

		<div class="legal">
			<span>© {year} EyeCheck.app · {site.legalEntity}</span>
			<div>
				{legalLinks.map((l) => <a href={l.href}>{l.title}</a>)}
			</div>
		</div>
	</div>
</footer>

<style>
	footer {
		background: var(--night);
		color: #b7c0d1;
	}

	.reminder {
		background: var(--lens);
		color: var(--ink);
	}
	.reminder-in {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px 40px;
		padding-top: 36px;
		padding-bottom: 36px;
	}
	.pitch {
		flex: 1 1 380px;
		display: flex;
		align-items: center;
		gap: 18px;
	}
	.pitch img {
		flex: 0 0 auto;
		width: 96px;
		height: auto;
	}
	.pitch div {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.pitch b {
		font-size: 22px;
		line-height: 28px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.pitch span {
		font-size: 14px;
		line-height: 20px;
		color: var(--slate);
	}
	form {
		flex: 1 1 420px;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 10px;
	}
	label {
		flex: 1 1 240px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 13px;
		line-height: 20px;
		font-weight: 600;
	}
	input {
		min-height: 48px;
		padding: 0 18px;
		border: 1px solid var(--muted);
		border-radius: 999px;
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		font-size: 16px;
		font-weight: 400;
	}

	.main {
		display: flex;
		flex-direction: column;
		gap: 36px;
		padding-top: 52px;
		padding-bottom: 28px;
	}
	.top {
		display: flex;
		flex-wrap: wrap;
		gap: 36px;
	}
	.brand {
		flex: 1.4 1 260px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		font-size: 14px;
		line-height: 1.6;
	}
	.logo {
		display: flex;
	}
	.logo img {
		height: 52px;
		width: auto;
	}
	.reviewed {
		align-self: flex-start;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 14px;
		border: 1px solid #22305a;
		border-radius: 14px;
		background: #111d3d;
		color: #b7c0d1;
		font-size: 13px;
		line-height: 20px;
		text-decoration: none;
	}
	.avatar {
		width: 36px;
		height: 36px;
		border: 1px solid #22305a;
		border-radius: 18px;
		background: #16244a;
	}
	.who {
		display: flex;
		flex-direction: column;
	}
	.who b {
		display: flex;
		align-items: center;
		gap: 5px;
		color: #f3f6fc;
		font-weight: 600;
	}
	.socials {
		display: flex;
		gap: 8px;
	}
	.socials a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: 1px solid #22305a;
		border-radius: 22px;
		background: #111d3d;
		color: #f3f6fc;
	}

	.cols {
		flex: 4 1 600px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 28px;
		font-size: 14px;
		line-height: 20px;
	}
	.cols div {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.cols b {
		color: #f3f6fc;
		font-size: 15px;
		font-weight: 600;
	}
	.cols a {
		color: #b7c0d1;
		text-decoration: none;
	}
	.cols a:hover,
	.legal a:hover {
		color: #f3f6fc;
	}

	.disclaimer {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		padding: 16px 18px;
		border: 1px solid #22305a;
		border-radius: 14px;
		background: #111d3d;
	}
	.disclaimer svg {
		flex: 0 0 auto;
		margin-top: 1px;
	}
	.disclaimer p {
		color: #b7c0d1;
		font-size: 13px;
		line-height: 1.6;
	}

	.legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 20px;
		border-top: 1px solid #22305a;
		color: #8c97ad;
		font-size: 13px;
		line-height: 20px;
	}
	.legal div {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 22px;
	}
	.legal a {
		color: #b7c0d1;
	}
</style>
