---
import { site, routes, footerColumns, legalLinks } from '../data/site';
import { socialLinks } from '../data/social';

const year = new Date().getFullYear();
// Internal page links get a trailing slash, so they don't take an extra redirect hop. Anchors and mailto links are left alone.
const slash = (href: string) => (href.startsWith('/') && !href.includes('#') && !href.endsWith('/') ? `${href}/` : href);
// Shown only once an accessibility statement page exists. TODO: optional short accessibility statement page.
const hasAccessibility = Object.keys(import.meta.glob('../pages/accessibility.astro')).length > 0;
// TODO: render a "Cookie settings" button that reopens the consent banner once GA4 or AdSense (and the banner) are added.
const hasConsentBanner = false;
---

<footer>
	<div class="reminder">
		<div class="wrap reminder-in">
			<div class="pitch">
				<img src="/images/test-reading-glasses.svg" alt="" width="96" height="66" loading="lazy" />
				<div>
					<b>Get a reminder to re-check your eyes</b>
					<span>One email in 12 months. Nothing else. Unsubscribe any time.</span>
				</div>
			</div>
			{/* Sends {"email": "..."} as JSON to POST /reminder/subscribe, the same payload the old site's results page used. */}
			<form novalidate data-endpoint="/reminder/subscribe" data-success="Thanks! We’ll remind you in 12 months.">
				<label for="reminder-email">
					Email address
					<input type="email" id="reminder-email" name="email" autocomplete="email" required aria-describedby="reminder-email-error" />
				</label>
				<button type="submit" class="btn solid">Remind me</button>
				<p class="field-error" id="reminder-email-error" hidden></p>
				<p class="field-error" role="alert" data-form-error hidden></p>
			</form>
		</div>
	</div>

	<div class="wrap main">
		<div class="top">
			<div class="brand">
				<a href={routes.home} aria-label="EyeCheck home" class="logo">
					<img src="/images/logo-white.svg" alt="EyeCheck" width="1103" height="160" loading="lazy" />
				</a>
				<span>Free vision screening anyone can use, so eye problems are caught early.</span>
				{/* Only profiles with a URL in site.social are shown, so no icon links to "#". */}
				{
					socialLinks.some((s) => s.href) && (
						<div class="socials">
							{socialLinks
								.filter((s) => s.href)
								.map((s) => (
									<a href={s.href} target="_blank" rel="noopener" aria-label={`EyeCheck on ${s.name}`}>
										<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<path d={s.icon} />
										</svg>
									</a>
								))}
						</div>
					)
				}
			</div>
			<nav aria-label="Footer" class="cols">
				{
					footerColumns.map((col) => (
						<div>
							<b>{col.title}</b>
							{col.links.map((l) => (
								<a href={slash(l.href)}>{l.title}</a>
							))}
						</div>
					))
				}
			</nav>
		</div>

		<div class="disclaimer">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7AA7FF" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16v.01"></path></svg>
			<p>
				EyeCheck is a vision screening tool. It does not diagnose eye conditions or replace a full eye exam by an optometrist or
				ophthalmologist. If you notice sudden changes in your vision, seek care straight away.
			</p>
		</div>

		<div class="legal">
			<span>
				© {year} EyeCheck.app · Developed by <a href={site.company.url} target="_blank" rel="noopener">{site.company.name}</a>, {site.company.country} · UEN{' '}
				{site.company.uen}
			</span>
			<div>
				{legalLinks.map((l) => <a href={slash(l.href)}>{l.title}</a>)}
				{
					hasConsentBanner && (
						<button type="button" class="link-button" data-cookie-settings>
							Cookie settings
						</button>
					)
				}
				{hasAccessibility && <a href="/accessibility/">Accessibility</a>}
			</div>
		</div>
	</div>
</footer>

<style>
	footer {
		background: var(--night);
		color: #b7c0d1;
	}

	.reminder {
		background: var(--lens);
		color: var(--ink);
	}
	.reminder-in {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px 40px;
		padding-top: 36px;
		padding-bottom: 36px;
	}
	.pitch {
		flex: 1 1 380px;
		display: flex;
		align-items: center;
		gap: 18px;
	}
	.pitch img {
		flex: 0 0 auto;
		width: 96px;
		height: auto;
	}
	.pitch div {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.pitch b {
		font-size: 22px;
		line-height: 28px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.pitch span {
		font-size: 14px;
		line-height: 20px;
		color: var(--slate);
	}
	form {
		flex: 1 1 420px;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 10px;
	}
	label {
		flex: 1 1 240px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 13px;
		line-height: 20px;
		font-weight: 600;
	}
	input {
		min-height: 48px;
		padding: 0 18px;
		border: 1px solid var(--muted);
		border-radius: 999px;
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		font-size: 16px;
		font-weight: 400;
	}

	.main {
		display: flex;
		flex-direction: column;
		gap: 36px;
		padding-top: 52px;
		padding-bottom: 28px;
	}
	.top {
		display: flex;
		flex-wrap: wrap;
		gap: 36px;
	}
	.brand {
		flex: 1.4 1 260px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		font-size: 14px;
		line-height: 1.6;
	}
	.logo {
		display: flex;
	}
	.logo img {
		height: 40px;
		width: auto;
	}
	.reviewed {
		align-self: flex-start;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 14px;
		border: 1px solid #22305a;
		border-radius: 14px;
		background: #111d3d;
		color: #b7c0d1;
		font-size: 13px;
		line-height: 20px;
		text-decoration: none;
	}
	.avatar {
		width: 36px;
		height: 36px;
		border: 1px solid #22305a;
		border-radius: 18px;
		background: #16244a;
	}
	.who {
		display: flex;
		flex-direction: column;
	}
	.who b {
		display: flex;
		align-items: center;
		gap: 5px;
		color: #f3f6fc;
		font-weight: 600;
	}
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.socials a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: 1px solid #22305a;
		border-radius: 22px;
		background: #111d3d;
		color: #f3f6fc;
	}
	.socials a:hover {
		border-color: #7aa7ff;
		color: #ffffff;
	}

	.cols {
		flex: 4 1 600px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 28px;
		font-size: 14px;
		line-height: 20px;
	}
	.cols div {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.cols b {
		color: #f3f6fc;
		font-size: 15px;
		font-weight: 600;
	}
	.cols a {
		color: #b7c0d1;
		text-decoration: none;
	}
	.cols a:hover,
	.legal a:hover {
		color: #f3f6fc;
	}

	.disclaimer {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		padding: 16px 18px;
		border: 1px solid #22305a;
		border-radius: 14px;
		background: #111d3d;
	}
	.disclaimer svg {
		flex: 0 0 auto;
		margin-top: 1px;
	}
	.disclaimer p {
		color: #b7c0d1;
		font-size: 13px;
		line-height: 1.6;
	}

	.legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 20px;
		border-top: 1px solid #22305a;
		color: #8c97ad;
		font-size: 13px;
		line-height: 20px;
	}
	.legal div {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 22px;
	}
	.legal a {
		color: #b7c0d1;
	}
	.link-button {
		padding: 0;
		border: 0;
		background: none;
		color: #b7c0d1;
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}
	.field-error {
		flex-basis: 100%;
		margin: 0;
		color: var(--ink);
		font-size: 14px;
		line-height: 20px;
		font-weight: 500;
	}
	.field-error::before {
		content: '! ';
		color: var(--blue);
		font-weight: 700;
	}
	input[aria-invalid='true'] {
		border-color: var(--ink);
		outline: 1px solid var(--ink);
	}
	.reminder :global(.form-done) {
		flex: 1 1 420px;
		padding: 14px 20px;
		border-radius: 14px;
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		font-weight: 500;
	}
</style>

<script>
	import '../scripts/api-form';
</script>
