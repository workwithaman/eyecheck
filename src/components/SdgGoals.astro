---
// The four UN Sustainable Development Goal cards and the UN's required notice, shared by Home and About us.
// Wording, icons and colours live here. The page supplies its own section, eyebrow, heading and intro.
// `colour` is the UN's colour for each goal: card top border only (too low-contrast for small text).
// The Goal 3 figures are the build-time /statistics numbers, the same as the stats on each page.
import { site, routes } from '../data/site';

interface Props {
	// Icon size in px (Home 64, About us 56).
	iconSize?: number;
	// Minimum card width in px before the grid drops a column (Home 240, About us 230).
	minCard?: number;
}

const { iconSize = 64, minCard = 240 } = Astro.props;

const goals = [
	{
		n: 3,
		colour: '#4C9F38',
		title: 'Good health and well-being',
		text: 'Catches vision problems early, before they affect daily life, so people know when to see an eye doctor.',
		proof: `${site.peopleScreened} people screened · ${site.peopleReferred} referred`,
	},
	{
		n: 4,
		colour: '#C5192D',
		title: 'Quality education',
		text: 'Undetected vision problems hold children back in class. Schools can screen a whole class for free.',
		link: { text: 'Free classroom screening →', href: routes.schools },
	},
	{
		n: 8,
		colour: '#A21942',
		title: 'Decent work and economic growth',
		text: 'Good vision helps people work safely and well. A quick check shows adults when it’s time for a full exam.',
		proof: 'Free for adults · about 5 minutes',
	},
	{
		n: 10,
		colour: '#DD1367',
		title: 'Reduced inequalities',
		text: 'No app, no appointment and no cost, so families far from an eye clinic can still get screened.',
		link: { text: 'For charities and community programmes →', href: routes.charities },
	},
];
---

<div class="sdg-grid" style={`--sdg-min: ${minCard}px; --sdg-icon: ${iconSize}px`}>
	{
		goals.map((g) => (
			<article class="sdg-card" style={`border-top-color: ${g.colour}`}>
				<div class="sdg-top">
					{/* Official icon, unaltered. */}
					<img
						src={`/images/sdg/sdg${g.n}.png`}
						alt={`UN Sustainable Development Goal ${g.n}: ${g.title}`}
						width={iconSize}
						height={iconSize}
						loading="lazy"
					/>
					<span class="sdg-label">Goal {g.n}</span>
				</div>
				<h3>{g.title}</h3>
				<p class="sdg-text">{g.text}</p>
				<div class="sdg-proof">{g.link ? <a href={g.link.href}>{g.link.text}</a> : <b>{g.proof}</b>}</div>
			</article>
		))
	}
</div>
<div class="sdg-foot">
	<p>
		SDG icons courtesy of the United Nations. The content of this page has not been approved by the United Nations and does not reflect
		the views of the United Nations or its officials or Member States.
	</p>
	<a href="https://sdgs.un.org/goals" target="_blank" rel="noopener">About the 17 goals ↗</a>
</div>

<style>
	/* 4 across on desktop, 2 on tablet, 1 on phone. */
	.sdg-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(var(--sdg-min), 1fr));
		gap: 20px;
	}
	.sdg-card {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 24px;
		border: 1px solid var(--line);
		border-top: 6px solid;
		border-radius: 16px;
		background: var(--surface);
	}
	.sdg-top {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.sdg-top img {
		flex: 0 0 auto;
		width: var(--sdg-icon);
		height: var(--sdg-icon);
		border-radius: 6px;
	}
	.sdg-label {
		color: var(--slate);
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 16px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.sdg-text {
		font-size: 15px;
		line-height: 24px;
	}
	/* Pinned to the bottom, with room for two lines, so the proof rows (and their top borders) line up across a row of
	   cards even when one proof line wraps. */
	.sdg-proof {
		margin-top: auto;
		min-height: 55px;
		padding-top: 14px;
		border-top: 1px solid var(--line);
		font-size: 14px;
		line-height: 20px;
	}
	.sdg-proof b {
		color: var(--ink);
		font-weight: 600;
	}
	.sdg-proof a {
		color: var(--blue);
		font-weight: 600;
		text-decoration: none;
	}
	.sdg-proof a:hover {
		text-decoration: underline;
	}
	.sdg-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 24px;
		padding-top: 18px;
		border-top: 1px solid var(--line);
	}
	.sdg-foot p {
		max-width: 760px;
		color: var(--muted);
		font-size: 13px;
		line-height: 20px;
	}
	.sdg-foot a {
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
	}
</style>
