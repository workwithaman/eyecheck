---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../data/site';
---

<Layout title={"Pediatric Eye Chart for Preschoolers (Free PDF) | EyeCheck.app"} active="charts">
	<div class="inner">
	<div class="wrap crumb">Home › Eye charts › Pediatric chart</div>
	<section class="wrap" style="padding-top:20px;padding-bottom:36px;display:flex;flex-wrap:wrap;gap:32px">
	  <div class="ph" style="flex:1 1 380px;height:520px">[Shapes chart preview (apple, house, circle, square)]</div>
	  <div style="flex:1 1 380px;display:flex;flex-direction:column;gap:16px">
	    <h1>Pediatric Eye Chart for Preschoolers (Free PDF)</h1>
	    <p class="muted">[Answer-first: a picture-shape chart for children who can’t read letters yet, from about age 3. Includes a matching card.]</p>
	    <div class="card">
	      <span class="eyebrow">Download</span>
	      <div style="display:flex;flex-wrap:wrap;gap:10px"><a href="#" class="btn solid">Chart · Letter</a><a href="#" class="btn solid">Chart · A4</a><a href="#" class="btn">Matching card</a></div>
	      <span class="note">Print at 100% · 10 ft distance · [file size]</span>
	    </div>
	    <span class="note">[Avatar] Reviewed by [NAME], OD · Last reviewed [DATE]</span>
	  </div>
	</section>
	
	<section class="sec" style="background:var(--surface-2)"><div class="wrap narrow" style="display:flex;flex-direction:column;gap:28px">
	  <div style="display:flex;flex-direction:column;gap:10px"><h2>How to test a preschooler’s vision at home</h2><p class="muted">[Make it a game; practise shapes up close first; patch one eye]</p><div class="ph" style="height:150px">[Illustration: parent + child + chart]</div></div>
	  <div style="display:flex;flex-direction:column;gap:10px"><h2>What a 3–5 year old should be able to see</h2><p class="muted">[Age-based expectations, cited]</p></div>
	  <div style="display:flex;flex-direction:column;gap:10px"><h2>When to book a children’s eye exam</h2><p class="muted">[Red flags; link to /lazy-eye-test and /color-blind-test/kids]</p></div>
	</div></section>
	
	<section class="sec"><div class="wrap narrow" style="display:flex;flex-direction:column;gap:8px">
	  <h2 style="margin-bottom:12px">Pediatric eye chart FAQ</h2>
	  <div class="faq"><span>What age can a child use an eye chart?</span><span>+</span></div>
	  <div class="faq"><span>My child won’t keep the patch on. What can I do?</span><span>+</span></div>
	  <div class="faq"><span>Can teachers use this chart in class?</span><span>+</span></div>
	</div></section>
	
	<section class="sec" style="background:var(--surface-2)"><div class="wrap" style="display:flex;flex-direction:column;gap:20px">
	  <h2>Other printable charts</h2>
	  <div class="grid3">
	    <a href={routes.chartTumblingE} class="card" style="text-decoration:none"><div class="ph" style="height:110px">[Thumb]</div><h3>Tumbling E chart</h3></a>
	    <a href={routes.chartSnellen} class="card" style="text-decoration:none"><div class="ph" style="height:110px">[Thumb]</div><h3>Snellen chart</h3></a>
	    <a href={routes.chart10Feet} class="card" style="text-decoration:none"><div class="ph" style="height:110px">[Thumb]</div><h3>10-foot chart</h3></a>
	    <a href={routes.start} class="card" style="text-decoration:none"><div class="ph" style="height:110px">[Online test]</div><h3>Kids online eye test</h3></a>
	  </div>
	</div></section>
	</div>
</Layout>
