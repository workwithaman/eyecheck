---
import AudiencePage from '../components/AudiencePage.astro';
---

<AudiencePage
	slug="academic-collaboration"
	crumb="Research"
	h1="Vision Research Collaboration"
	intro="Partner with universities and research institutions to advance vision science."
	why={{
		title: 'Research collaboration',
		list: ['Real-time, large-scale data collection', 'Standardised, consistent testing protocols', 'Big-data analysis across populations'],
	}}
	faq={{ title: '[FAQ heading]', items: [{ q: '[Question 1]' }, { q: '[Question 2]' }, { q: '[Question 3]' }] }}
	form={{
		fields: [
			{ label: 'Institution', required: true },
			{ label: 'Department' },
			{ label: 'Institution website', type: 'url' },
			{ label: 'Lead researcher', required: true },
			{ label: 'Email', type: 'email', required: true },
			{ label: 'Phone', type: 'tel' },
			{ label: 'Project title', required: true },
			{ label: 'Estimated timeframe' },
			{ label: 'Funding source (optional)' },
			{ label: 'Ethics committee approval status' },
			{ label: 'Research description', type: 'textarea', required: true },
			{ label: 'Expected outcomes (optional)', type: 'textarea' },
			{
				label: 'Additional documents',
				type: 'file',
				accept: '.pdf,.doc,.docx',
				hint: 'PDF, DOC or DOCX, up to 5 files, max 5 MB each',
			},
		],
		consents: ['I consent to media usage', 'I agree to the terms and conditions'],
		button: 'Submit research proposal',
	}}
/>
