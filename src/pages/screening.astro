---
import Layout from '../layouts/Layout.astro';
import { routes } from '../data/site';
---

<Layout title={"Start Your Free Eye Test | EyeCheck.app"}>
	<div class="inner">
	<div class="wrap crumb">Home › Start eye test</div>
	<section class="wrap" style="padding-top:20px;padding-bottom:32px;display:flex;flex-direction:column;gap:12px;max-width:860px;margin-left:auto;margin-right:auto">
	  <h1>Start Your Free Eye Test</h1>
	  <p class="muted">Three quick steps, then the test runs full screen. About 1–2 minutes per eye.</p>
	</section>

	<section class="wrap" style="max-width:860px;display:flex;flex-direction:column;gap:20px;padding-bottom:48px">
	  <div class="card">
	    <span class="eyebrow">Step 1 of 3</span>
	    <h2 id="age-heading">Who is taking the test?</h2>
	    <div class="ages" role="group" aria-labelledby="age-heading" data-ages>
	      <button type="button" class="card age" data-optotype="shapes" aria-pressed="false"><span class="age-art"><img src="/images/test-color-blind.svg" alt="" width="132" height="90" /></span><h3>Child, ages 3–7</h3><span class="muted">Picture shapes</span></button>
	      <button type="button" class="card age selected" data-optotype="landolt" aria-pressed="true"><span class="age-art"><img src="/images/test-visual-acuity.svg" alt="" width="132" height="90" /></span><h3>Ages 8 and up</h3><span class="muted">Landolt C rings</span></button>
	    </div>
	  </div>

	  <div class="card">
	    <span class="eyebrow">Step 2 of 3</span>
	    <h2>Check your setup</h2>
	    <div class="grid3">
	      <div style="display:flex;flex-direction:column;gap:8px"><span class="setup-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg></span><h3>A bright screen, 33 cm (13″) or larger</h3><p class="muted">A laptop or desktop. Phones are too small for accurate results.</p></div>
	      <div style="display:flex;flex-direction:column;gap:8px"><span class="setup-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h18M6 9l-3 3 3 3M18 9l3 3-3 3" /></svg></span><h3>Sit 3 m (10 ft) away</h3><p class="muted">About 4 big steps for an adult.</p></div>
	      <div style="display:flex;flex-direction:column;gap:8px"><span class="setup-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="5" /><path d="M12 7v3" /></svg></span><h3>Wireless mouse on a flat surface</h3><p class="muted">So you can answer from 3 m away.</p></div>
	    </div>
	  </div>

	  <form id="screening-form" class="details" data-screening>
	    <div class="card">
	      <span class="eyebrow">Step 3 of 3</span>
	      <h2>Your details</h2>
	      <div class="fields">
	        <label for="full-name">Full name<input type="text" id="full-name" name="fullName" autocomplete="name" required /></label>
	        <label for="email">Email address<input type="email" id="email" name="email" autocomplete="email" required /></label>
	        <label for="birth-date" class="short">Birth date<input type="date" id="birth-date" name="birthDate" autocomplete="bday" required /></label>
	        <label for="country" class="short">Country<input type="text" id="country" name="country" autocomplete="country-name" required /></label>
	        <label for="city" class="short">City<input type="text" id="city" name="city" autocomplete="address-level2" required /></label>
	      </div>
	      <label for="screening-consent" class="check">
	        <input type="checkbox" id="screening-consent" name="consent" required />
	        <span>I understand that EyeCheck.app is a digital screening tool and not a substitute for a professional eye exam.</span>
	      </label>
	      <p class="muted terms">
	        By proceeding, you agree to the <a href={`${routes.privacy}/`}>Privacy Policy</a> and <a href={`${routes.terms}/`}>Terms of Service</a>.
	      </p>
	    </div>

	    <div class="start">
	      <button type="submit" class="btn solid">Start screening</button>
	      <span class="muted" style="font-size:14px">Opens full screen. Press Esc to exit.</span>
	    </div>
	    <p class="status" role="status" aria-live="polite" data-status></p>
	  </form>
	  <!-- After Start: the Unity WebGL test opens in a full-screen overlay (shape or landolt build). Results are posted to /user/update-results, then the visitor is redirected to /result. -->
	</section>

	<section class="sec" style="background:var(--surface-2)"><div class="wrap" style="max-width:860px;display:flex;flex-direction:column;gap:14px">
	  <h2>Before you start</h2>
	  <p class="muted">Wear your usual glasses or contact lenses, use good lighting, and test one eye at a time.</p>
	  <p class="muted">Testing a young child? Show them the <a href={routes.chartPediatric}>Shapes Chart</a> first so they know the shapes (optional).</p>
	  <p class="muted">No screen big enough? <a href={routes.eyeCharts}>Print an eye chart instead</a>.</p>
	  <p class="muted">EyeCheck.app is a screening tool, not a diagnosis. If you notice sudden changes in your vision, see an eye doctor straight away. Read <a href={`${routes.howWeTest}/`}>how we test</a> or <a href={`${routes.help}/`}>get help</a>.</p>
	</div></section>
	</div>
</Layout>

<script>
	// Nothing is sent on page load. The session is created and the details saved only after "Start screening".
	const API = 'https://monkfish-app-lnjjx.ondigitalocean.app';

	const ages = document.querySelector<HTMLElement>('[data-ages]');
	const form = document.querySelector<HTMLFormElement>('[data-screening]');
	const status = document.querySelector<HTMLElement>('[data-status]');
	let optotype = 'landolt';

	ages?.querySelectorAll<HTMLButtonElement>('button').forEach((btn) => {
		btn.addEventListener('click', () => {
			optotype = btn.dataset.optotype ?? 'landolt';
			ages.querySelectorAll('button').forEach((b) => {
				b.classList.toggle('selected', b === btn);
				b.setAttribute('aria-pressed', String(b === btn));
			});
		});
	});

	const post = async (path: string, body?: unknown) => {
		const res = await fetch(API + path, {
			method: 'POST',
			headers: body ? { 'Content-Type': 'application/json' } : undefined,
			body: body ? JSON.stringify(body) : undefined,
			credentials: 'include',
		});
		if (!res.ok) throw new Error(`${path}: HTTP ${res.status}`);
	};

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const data = new FormData(form);
		if (button) button.disabled = true;
		if (status) status.textContent = 'Saving your details…';
		try {
			await post('/user/create-user');
			await post('/user/save-info', {
				name: data.get('fullName'),
				emailAddress: data.get('email'),
				birthDate: data.get('birthDate'),
				country: data.get('country'),
				city: data.get('city'),
			});
			// "shapes" for ages 3–7, "landolt" for 8 and up: picks the Unity build the test opens with.
			await post('/user/update-optotype', { optotype });
			if (status) status.textContent = 'Your details are saved.';
			// TODO: open the Unity test (/builds/shape or /builds/landolt) full screen here.
		} catch (err) {
			console.error('Could not start the screening:', err);
			if (status) status.textContent = 'We couldn’t save your details. Please check your connection and try again.';
		} finally {
			if (button) button.disabled = false;
		}
	});
</script>

<style>
	.ages {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}
	.age {
		flex: 1 1 240px;
		align-items: center;
		background: var(--surface);
		font: inherit;
		cursor: pointer;
	}
	.age-art {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 110px;
		border-radius: 14px;
		background: var(--lens);
	}
	.age-art img {
		width: auto;
		height: 90px;
	}
	.setup-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: 14px;
		background: var(--lens);
		color: var(--blue);
	}
	.age.selected {
		border: 2px solid var(--blue);
	}
	.details {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.fields {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}
	.fields label {
		flex: 1 1 240px;
	}
	.fields label.short {
		flex-basis: 160px;
	}
	.inner .check {
		flex-direction: row;
		align-items: flex-start;
		gap: 10px;
		font-weight: 400;
	}
	.inner .check input {
		flex: 0 0 auto;
		width: 18px;
		height: 18px;
		min-height: 0;
		margin: 2px 0 0;
		padding: 0;
	}
	.terms {
		font-size: 14px;
	}
	.start {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}
	.status:empty {
		display: none;
	}
</style>
