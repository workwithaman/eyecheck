---
import AudiencePage from '../components/AudiencePage.astro';
---

<AudiencePage
	crumb="Schools"
	h1="Vision Screening for Schools"
	intro="Make sure every student can see clearly enough to learn well. Runs on school computers or tablets, from preschool up, with minimal staff training."
	image={{ src: '/images/schools-hero.jpg', alt: 'Students and teachers using vision screening technology', width: 1000, height: 667 }}
	why={{
		title: 'Why screen vision in schools',
		benefits: [
			{ title: 'Suitable for preschools', text: 'Age-appropriate tests for children from about age 3 in preschool and early childhood programmes.' },
			{ title: 'Early detection of eye problems', text: 'Find vision issues before they affect learning and development.' },
			{ title: 'Easy to implement', text: 'No software to install, works on any device, minimal training for teachers and staff.' },
		],
		listTitle: 'Perfect for educational institutions',
		list: [
			'Shorter time for routine vision checks',
			'Early detection of vision problems in students',
			'Stronger parent relationships through annual eyesight monitoring',
			'Can be built into the health curriculum',
			'Scales from one classroom to a whole district',
		],
	}}
	how={{ title: 'How school screening works', steps: ['Set up a station', 'Screen each student', 'Share results with parents'] }}
	plan={{
		label: 'School plan',
		price: 'SGD 100',
		unit: '100 eyesight screenings (SGD 1 per screening)',
		items: ['PDF report for each screening', 'Easy setup and deployment', 'No software installation', 'Training provided'],
	}}
	resources={{ title: 'Free resources for schools' }}
	faq={{
		title: 'School vision screening FAQ',
		questions: ['How much does school screening cost?', 'What equipment do we need?', 'How is student data handled?'],
	}}
	form={{
		fields: [
			{ label: 'School / institution name', required: true },
			{ label: 'Contact person name', required: true },
			{ label: 'Role (e.g. Principal, Nurse, Teacher)' },
			{ label: 'Email', type: 'email', required: true },
			{ label: 'Contact number', type: 'tel' },
			{ label: 'School level', placeholder: 'Preschool, Elementary, High School' },
			{ label: 'Additional comments or requirements (optional)', type: 'textarea' },
		],
		button: 'Schedule an online session',
	}}
/>
