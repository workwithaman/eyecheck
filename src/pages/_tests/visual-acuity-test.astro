---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../data/site';

// "Last updated" date as YYYY-MM-DD. Empty = the build date.
const updated = '';
const updatedIso = updated || new Date().toISOString().slice(0, 10);
const updatedText = new Date(`${updatedIso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// Moved here from the home page.
const steps = [
	{
		title: 'Set up your screen',
		text: 'Use a bright screen of at least 33 cm (13″) and a wireless mouse on a flat surface. Sit 3 m (10 ft) away.',
	},
	{
		title: 'Cover one eye and answer',
		text: 'Picture shapes for ages 3–7, Landolt C rings for ages 8 and up. About 1–2 minutes per eye.',
	},
	{
		title: 'Get your results',
		text: 'A Pass or Refer result for each eye. Want more detail? Get the full PDF report for $2.',
	},
];
---

<Layout title={"Visual Acuity Test: Free Online Check | EyeCheck.app"} active="tests">
	<div class="inner">
	<div class="wrap crumb">Home › Eye tests › Visual acuity test</div>
	<section class="wrap narrow" style="padding-top:20px;padding-bottom:28px;display:flex;flex-direction:column;gap:14px">
	  <h1>Visual Acuity Test: Check How Sharp Your Vision Is</h1>
	  <p class="muted">[Answer-first intro, 40–60 words: what visual acuity means, what score you get (6/6, 20/20), about 5 minutes per test.]</p>
	  <span class="note">Last updated <time datetime={updatedIso}>{updatedText}</time></span>
	</section>

	<section id="how" class="wrap narrow how" aria-labelledby="how-title">
	  <h2 id="how-title">How the visual acuity test works</h2>
	  <div class="device-note" role="note">
	    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 11v6M12 7.5v.01"></path></svg>
	    <p>This test needs a computer or tablet: a bright screen of at least 33 cm (13″) and 3 m (10 ft) of space. It does not work on a phone.</p>
	  </div>
	  <ol class="grid3 steps">
	    {
	      steps.map((s, i) => (
	        <li class="card">
	          <span class="ic num" aria-hidden="true">{i + 1}</span>
	          <h3>{s.title}</h3>
	          <p class="muted">{s.text}</p>
	        </li>
	      ))
	    }
	  </ol>
	</section>

	<section class="wrap narrow" style="padding-bottom:40px">
	  <div class="tool">
	    <span class="eyebrow">Interactive test · React island</span>
	    <div style="display:flex;flex-wrap:wrap;gap:16px">
	      <button class="card" style="flex:1 1 220px;align-items:center;font:inherit;background:var(--surface)"><div class="ph" style="width:100%;height:90px">[Shapes]</div><h3>Ages 3–7</h3></button>
	      <button class="card" style="flex:1 1 220px;align-items:center;font:inherit;background:var(--surface)"><div class="ph" style="width:100%;height:90px">[Landolt C]</div><h3>Ages 8+</h3></button>
	    </div>
	    <div class="ph" style="height:200px;border-style:dashed">[Setup check (screen size, distance) then Start → Unity test full screen → result per eye in 6/x and 20/x]</div>
	    <button class="btn solid" style="align-self:flex-start">Start visual acuity test</button>
	  </div>
	  <p class="note" style="margin-top:12px">[Disclaimer: a screening, not a diagnosis.]</p>
	</section>
	
	<section class="sec"><div class="wrap narrow" style="display:flex;flex-direction:column;gap:16px">
	  <span class="eyebrow">Video overview</span>
	  <h2>Video: how the visual acuity test works</h2>
	  <p class="muted">[60–90 sec: screen calibration, sitting distance, answering the Landolt C, reading 6/x and 20/x.]</p>
	  <div class="ph" style="aspect-ratio:16/9;width:100%;border-radius:12px;flex-direction:column;gap:12px">
	    <span style="width:76px;height:76px;border-radius:38px;background:var(--ink);display:flex;align-items:center;justify-content:center"><svg width="30" height="30" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg></span>
	    <span>[Poster frame · 1:30]</span>
	  </div>
	  <div style="display:flex;flex-wrap:wrap;gap:8px 20px" class="note"><span>Captions on by default</span><span>▸ Read transcript (in HTML, expandable)</span><span>Click-to-load: no YouTube script until play</span></div>
	</div></section>
	
	<section class="sec"><div class="wrap narrow" style="display:flex;flex-direction:column;gap:14px">
	  <h2>What your visual acuity score means</h2>
	  <div style="overflow-x:auto"><table>
	    <tr><th>Score (metric)</th><th>Score (US)</th><th>What it means</th></tr>
	    <tr><td>6/6</td><td>20/20</td><td>[Typical healthy vision]</td></tr>
	    <tr><td>6/12</td><td>20/40</td><td>[Meaning + driving threshold note]</td></tr>
	    <tr><td>6/60</td><td>20/200</td><td>[Meaning + see an eye doctor]</td></tr>
	  </table></div>
	</div></section>
	
	<section class="sec"><div class="wrap narrow" style="display:flex;flex-direction:column;gap:28px">
	  <div style="display:flex;flex-direction:column;gap:10px"><h2>What is visual acuity?</h2><p class="muted">[2 short paragraphs]</p></div>
	  <div style="display:flex;flex-direction:column;gap:10px"><h2>What does 20/20 vision mean?</h2><p class="muted">[Snellen fraction explained]</p></div>
	  <div style="display:flex;flex-direction:column;gap:10px"><h2>Normal visual acuity by age</h2><p class="muted">[Children vs adults table or list]</p></div>
	  <div style="display:flex;flex-direction:column;gap:10px"><h2>Landolt C vs Snellen chart</h2><p class="muted">[Why we use Landolt C; link to /eye-charts/snellen]</p></div>
	</div></section>
	
	<section class="sec" style="background:var(--surface-2)"><div class="wrap narrow" style="display:flex;flex-direction:column;gap:8px">
	  <h2 style="margin-bottom:12px">Visual acuity test FAQ</h2>
	  <div class="faq"><span>What is a normal visual acuity score?</span><span>+</span></div>
	  <div class="faq"><span>Can I test my visual acuity at home?</span><span>+</span></div>
	  <div class="faq"><span>Is 20/40 vision bad?</span><span>+</span></div>
	  <div class="faq"><span>What is the difference between an acuity test and an eye exam?</span><span>+</span></div>
	</div></section>
	
	<section class="sec"><div class="wrap" style="display:flex;flex-direction:column;gap:20px">
	  <h2>Related tests</h2>
	  <div class="grid3">
	    <a href={routes.chartPediatric} class="card" style="text-decoration:none"><h3>Printable pediatric chart</h3><span class="note">→ /eye-charts/pediatric</span></a>
	    <a href={routes.howWeTest} class="card" style="text-decoration:none"><h3>How we test</h3><span class="note">→ /how-we-test</span></a>
	    <a href={routes.chartSnellen} class="card" style="text-decoration:none"><h3>Printable Snellen chart</h3><span class="note">→ /eye-charts/snellen</span></a>
	  </div>
	</div></section>
	</div>
</Layout>

<style>
	.how {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding-bottom: 40px;
		/* Added to the site-wide 88px scroll padding, so /visual-acuity-test/#how lands just below the sticky header. */
		scroll-margin-top: 16px;
	}
	.device-note {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		padding: 16px 18px;
		border-radius: 12px;
		background: var(--lens);
		color: var(--ink);
		font-weight: 500;
	}
	.device-note svg {
		flex: none;
		margin-top: 2px;
		color: var(--blue);
	}
	.steps {
		margin: 0;
		padding: 0;
		list-style: none;
		/* Three across in the narrow column on desktop; one per row on a phone. */
		grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
	}
	.num {
		font-size: 20px;
		font-weight: 600;
	}
</style>
