---
import AudiencePage from '../components/AudiencePage.astro';
---

<AudiencePage
	slug="charity-support"
	crumb="Charities"
	h1="Free Vision Screening Support for Charities"
	intro="Free screening tools for organisations that provide vision screening to underprivileged children around the world."
	why={{
		title: 'Charity support programme',
		closing: 'Together, we can ensure that every child, regardless of their circumstances, has access to quality vision screening.',
	}}
	stories={[
		{
			title: 'School Vision Project',
			text: 'Screened over 5,000 children in rural communities, identifying over 800 cases requiring further care.',
		},
		{
			title: 'Urban Health Initiative',
			text: 'Screenings at community centres in underserved neighbourhoods, reaching 1,200 children in one month.',
		},
	]}
	faq={{ title: '[FAQ heading]', items: [{ q: '[Question 1]' }, { q: '[Question 2]' }, { q: '[Question 3]' }] }}
	form={{
		fields: [
			{ label: 'Organisation name', required: true },
			{ label: 'Website', type: 'url' },
			{ label: 'Contact person', required: true },
			{ label: 'Email', type: 'email', required: true },
			{ label: 'Phone', type: 'tel' },
			{ label: 'Expected number of screenings', type: 'number' },
			{ label: 'Project description', type: 'textarea', hint: 'Location, target population, and goals', required: true },
		],
		consents: ['I agree to the terms and conditions', 'I consent to media usage'],
		button: 'Submit application',
	}}
/>
