---
import Layout from '../../layouts/Layout.astro';
import PostCover from '../../components/PostCover.astro';
import { routes } from '../../data/site';
import { posts, formatDate, isoDate, shorten } from '../../data/posts';

// TODO: add pagination (/blog/page/[n]/) before there are more than 12 posts. Until then there is no pagination control.
const featured = posts.find((p) => p.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
// Chips only for categories that have at least one built post, in the order posts appear.
const categories = [...new Set(posts.map((p) => p.category))];
const slugOf = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const origin = Astro.site?.href ?? '/';
const blogUrl = new URL('/blog/', origin).href;
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Blog', name: 'EyeCheck.app Eye Health Blog', url: blogUrl, publisher: { '@id': new URL('/#organization', origin).href } },
		{
			'@type': 'ItemList',
			itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${blogUrl}${p.slug}/`, name: p.title })),
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', origin).href },
				{ '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
			],
		},
	],
};
---

<Layout
	title="Eye Health Blog: Guides for Parents & Adults | EyeCheck.app"
	description="Eye health guides for parents and adults: screen time, children's vision screening, eye exams and reading glasses, reviewed by an optometrist."
	active="blog"
>
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	<div class="inner">
		<div class="wrap crumb">Home › Blog</div>
		<section class="wrap intro">
			<h1>Eye Health Blog</h1>
			<p class="muted">Practical, medically reviewed guides on vision for children and adults.</p>
			{
				categories.length > 1 && (
					<div class="chips" role="group" aria-label="Filter by category" data-chips>
						<button type="button" class="chip on" aria-pressed="true" data-filter="all">
							All
						</button>
						{categories.map((c) => (
							<button type="button" class="chip" aria-pressed="false" data-filter={slugOf(c)}>
								{c}
							</button>
						))}
					</div>
				)
			}
			<p class="sr-only" aria-live="polite" data-count></p>
		</section>

		<section class="wrap posts">
			{
				featured && (
					<a href={`${routes.blog}${featured.slug}/`} class="card featured" data-post data-category={slugOf(featured.category)}>
						{featured.image && <PostCover image={featured.image} width={560} class="featured-img" eager />}
						<div class="featured-copy">
							<span class="note">Featured · {featured.category}</span>
							<h2>{featured.title}</h2>
							<p class="muted">{shorten(featured.summary)}</p>
							<span class="note">
								By {featured.author} · <time datetime={isoDate(featured.publishedAt)}>{formatDate(featured.publishedAt)}</time> ·{' '}
								{featured.readMinutes} min read
							</span>
						</div>
					</a>
				)
			}
			<div class="grid3">
				{
					rest.map((p) => (
						<a href={`${routes.blog}${p.slug}/`} class="card post-card" data-post data-category={slugOf(p.category)}>
							{p.image && <PostCover image={p.image} width={380} class="card-img" />}
							<span class="note">{p.category}</span>
							<h3>{p.title}</h3>
							<p class="muted excerpt">{shorten(p.summary, 120)}</p>
							<span class="note">
								By {p.author} · <time datetime={isoDate(p.publishedAt)}>{formatDate(p.publishedAt)}</time> · {p.readMinutes} min read
							</span>
						</a>
					))
				}
			</div>
		</section>
	</div>
</Layout>

<script>
	// Category filter. Without JavaScript every post stays visible.
	const chips = document.querySelector<HTMLElement>('[data-chips]');
	const cards = [...document.querySelectorAll<HTMLElement>('[data-post]')];
	const count = document.querySelector<HTMLElement>('[data-count]');
	chips?.querySelectorAll<HTMLButtonElement>('button').forEach((btn) => {
		btn.addEventListener('click', () => {
			const filter = btn.dataset.filter;
			chips.querySelectorAll('button').forEach((b) => {
				b.classList.toggle('on', b === btn);
				b.setAttribute('aria-pressed', String(b === btn));
			});
			let shown = 0;
			cards.forEach((card) => {
				const match = filter === 'all' || card.dataset.category === filter;
				card.hidden = !match;
				if (match) shown++;
			});
			if (count) count.textContent = `${shown} ${shown === 1 ? 'article' : 'articles'}`;
		});
	});
</script>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding-top: 20px;
		padding-bottom: 28px;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.chip {
		font: inherit;
		font-size: 14px;
		cursor: pointer;
	}
	/* Only inactive chips: the global .chip.on supplies the selected colours. */
	.chip:not(.on) {
		background: var(--surface);
	}
	.chip:focus-visible {
		outline: 3px solid var(--blue);
		outline-offset: 2px;
	}
	.posts {
		display: flex;
		flex-direction: column;
		gap: 28px;
		padding-bottom: 72px;
	}
	.featured {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		gap: 28px;
		padding: 0;
		overflow: hidden;
	}
	.featured :global(.featured-img) {
		flex: 1 1 380px;
		min-width: 0;
		width: 100%;
		height: 300px;
		object-fit: cover;
	}
	.featured-copy {
		flex: 1 1 380px;
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px 28px 28px 0;
	}
	.post-card {
		overflow: hidden;
		padding: 0 0 20px;
	}
	.post-card > :not(:global(.card-img)) {
		padding: 0 20px;
	}
	.post-card :global(.card-img) {
		width: 100%;
		height: 190px;
		object-fit: cover;
	}
	.excerpt {
		font-size: 15px;
		line-height: 23px;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	@media (max-width: 820px) {
		.featured-copy {
			padding: 0 22px 24px;
		}
	}
</style>
