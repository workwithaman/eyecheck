---
import Layout from '../layouts/Layout.astro';
import { routes } from '../data/site';
---

<Layout title={"We can’t find that page | EyeCheck.app"} noindex>
	<div class="inner">
	<section class="wrap" style="padding-top:72px;padding-bottom:72px;display:flex;flex-direction:column;gap:18px;align-items:center;text-align:center;max-width:860px">
	  <span class="note">Error 404</span>
	  <h1>We can’t find that page</h1>
	  <p class="muted">[One line: the page may have moved. Try one of these instead.]</p>
	  <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center"><a href={routes.start} class="btn solid">Start free eye test</a><a href={routes.home} class="btn">Go to homepage</a></div>
	</section>
	
	<section class="wrap" style="padding-bottom:64px;max-width:960px">
	  <div class="grid3">
	    <a href={routes.astigmatism} class="card" style="text-decoration:none"><h3>Astigmatism test</h3></a>
	    <a href={routes.colorBlind} class="card" style="text-decoration:none"><h3>Color blind test</h3></a>
	    <a href={routes.eyeCharts} class="card" style="text-decoration:none"><h3>Printable eye charts</h3></a>
	    <a href={routes.help} class="card" style="text-decoration:none"><h3>Help &amp; FAQ</h3></a>
	  </div>
	</section>
	</div>
</Layout>
