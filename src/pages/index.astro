---
import Layout from '../layouts/Layout.astro';
import { site, routes, tests, orgs } from '../data/site';
import { posts as blogPosts } from '../data/blog';
import { socialLinks, socialProfiles } from '../data/social';
import { testimonials } from '../data/live';

const title = 'Free Online Eye Test & Eye Test App | EyeCheck.app';
const description =
	'Check your eyes online in under 5 minutes. EyeCheck.app is a free online vision test for children from age 3 and adults, with no app or appointment needed.';

const steps = [
	{
		title: 'Set up your screen',
		text: 'Use a bright screen of at least 33 cm (13″) and a wireless mouse on a flat surface. Sit 3 m (10 ft) away.',
	},
	{
		title: 'Cover one eye and answer',
		text: 'Picture shapes for ages 3–7, Landolt C rings for ages 8 and up. About 1–2 minutes per eye.',
	},
	{
		title: 'Get your results',
		text: 'A Pass or Refer result for each eye. Want more detail? Get the full PDF report for $2.',
	},
];

const slides = [
	{ label: 'toddler screening', alt: 'Toddler performing online vision screening using shape matching cards on a laptop' },
	{ label: 'the test screen', alt: 'Interface of EyeCheck.app online vision screening tool showing a shape matching test' },
	{ label: 'family', alt: 'Happy family with parents and children, illustrating that EyeCheck is suitable for vision screening of all ages' },
	{ label: 'PDF report', alt: 'Preview of the PDF vision screening report showing eye test results' },
	{ label: 'classroom tablets', alt: 'Elementary school children using a tablet in a classroom for school vision screening' },
].map((s, i) => ({ ...s, src: `/images/hero/slide-${i + 1}.jpg` }));

const goals = [
	{ n: 3, title: 'Good health and well-being', text: 'Accessible screening supports early detection of vision issues.' },
	{ n: 4, title: 'Quality education', text: 'Fixing vision problems removes a barrier to learning.' },
	{ n: 8, title: 'Decent work and economic growth', text: 'Better vision health supports productivity and employment.' },
	{ n: 10, title: 'Reduced inequalities', text: 'Free screening for underserved communities narrows the gap in care.' },
];

const posts = [
	{ topic: 'Screen time', title: 'The 20-20-20 rule for eye strain', href: routes.blog + blogPosts[0].slug },
	{ topic: 'Children’s vision', title: 'Pediatric vision screening: what parents should know', href: routes.blog + blogPosts[1].slug },
	{ topic: 'Adult vision', title: 'How often should you get an eye exam?', href: routes.blog + blogPosts[2].slug },
];

const faqs = [
	{
		q: 'Can I check my eyes online for free?',
		a: 'Yes. Every EyeCheck test is free and runs in your browser on a computer, with no app or appointment needed.',
	},
	{
		q: 'Is there a free eye test app I can use on my phone?',
		a: 'EyeCheck works like an eye test app, but it runs in your browser, so there is nothing to download. For accurate results it needs a screen of at least 33 cm (13″), so use a laptop or desktop computer rather than a phone.',
	},
	{
		q: 'How accurate is an online eye test?',
		a: 'An online eye test is a screening tool. It can show signs that your vision may need attention, but the result depends on your screen, lighting and distance, and it cannot examine the health of your eyes. It does not replace a full eye exam.',
	},
	{
		q: 'Can I do an eye checkup online for my child?',
		a: 'Yes. Children from age 3 can take the test using shapes instead of letters, with an adult helping. If the result is outside the normal range, or you have any concerns, see an eye care professional.',
	},
	{
		q: 'How often should I get a full eye exam?',
		a: 'It depends on your age, health and risk factors, so follow your eye care professional’s advice. Many adults are advised to have an exam every one to two years. Book sooner if you notice a change in your vision.',
	},
];

const origin = Astro.site?.href ?? '/';
const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: site.name,
		url: origin,
		logo: new URL('/icon-512.png', origin).href,
		...(socialProfiles.length > 0 && { sameAs: socialProfiles }),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: site.name,
		url: origin,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebApplication',
		name: 'EyeCheck online eye test',
		url: origin,
		applicationCategory: 'HealthApplication',
		operatingSystem: 'Any',
		browserRequirements: 'Requires JavaScript',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'VideoObject',
		name: site.video.title,
		description: 'A step-by-step guide to the free online eye screening on EyeCheck.app, for kids and adults.',
		thumbnailUrl: new URL(site.video.poster, origin).href,
		uploadDate: site.video.uploadDate,
		duration: site.video.duration,
		embedUrl: `https://www.youtube.com/embed/${site.video.id}`,
		contentUrl: `https://www.youtube.com/watch?v=${site.video.id}`,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
];
---

<Layout title={title} description={description}>
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

	<section class="hero">
		<div class="wrap hero-in">
			<div class="hero-copy">
				<span class="pill">Free · No download · 3–4 minutes</span>
				<h1>Free online eye test: check your eyes in under 5 minutes</h1>
				<p class="lead">
					EyeCheck.app is a free online vision test that helps you screen for vision problems from your computer, with no app or
					appointment needed. For children from age 3 and adults.
				</p>
				<div class="actions">
					<a href={routes.start} class="btn solid">
						Start free eye test
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
					</a>
					<a href="#how" class="btn">How it works</a>
				</div>
				<div class="proof">
					<span class="reviewer">
						<span class="avatar"></span>
						<span><b>Reviewed by {site.reviewer}</b><br />{site.reviewerRole}</span>
					</span>
					<span class="screened">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
						<span><b>{site.peopleScreened}</b> people screened</span>
					</span>
				</div>
			</div>
			<div class="hero-art" data-slides>
				<div class="frame-wrap">
					<div class="frame">
						{
							slides.map((s, i) => (
								<img
									src={s.src}
									alt={s.alt}
									width="1280"
									height="720"
									class:list={['slide', { active: i === 0 }]}
									loading={i === 0 ? 'eager' : 'lazy'}
									fetchpriority={i === 0 ? 'high' : undefined}
								/>
							))
						}
					</div>
					<div class="suits">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
						<span>Suitable for children &amp; adults</span>
					</div>
				</div>
				<div class="thumbs" role="group" aria-label="Slides">
					{
						slides.map((s, i) => (
							<button type="button" class:list={['thumb', { active: i === 0 }]} aria-label={`Slide ${i + 1}: ${s.label}`} aria-pressed={i === 0 ? 'true' : 'false'}>
								<img src={s.src} alt="" width="1280" height="720" loading="lazy" />
							</button>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section id="tests" class="sec tests-sec">
		<div class="wrap stack">
			<div class="head narrow">
				<span class="eyebrow">Eye tests</span>
				<h2>Choose an eye test</h2>
				<p>Each test checks a different part of your vision. All of them are free.</p>
			</div>
			<div class="grid3">
				{
					tests.map((t) => (
						<a href={t.href} class="card test">
							{t.badge && <span class="badge corner">{t.badge}</span>}
							<div class:list={['art', { kids: t.kids }]}>
								<img src={t.img} alt="" width="161" height="110" loading="lazy" />
							</div>
							<h3>{t.title}</h3>
							<p>{t.desc}</p>
							<span class="more">Start test →</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section id="how" class="sec band">
		<div class="wrap stack">
			<div class="head">
				<span class="eyebrow">How it works</span>
				<h2>How the online eye check works</h2>
			</div>
			<ol class="grid3 steps">
				{
					steps.map((s, i) => (
						<li class="card">
							<span class="ic num" aria-hidden="true">{i + 1}</span>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="sec">
		<div class="wrap video-sec">
			<span class="eyebrow">Video overview</span>
			<h2>Watch: how to use EyeCheck</h2>
			<p>A step-by-step guide to the free online eye screening, for kids and adults.</p>
			<div class="video" data-video={site.video.id}>
				<a href={`https://www.youtube.com/watch?v=${site.video.id}`} class="poster" aria-label={`Play video: ${site.video.title}`}>
					<img src={site.video.poster} alt="" width="1280" height="720" loading="lazy" />
					<span class="play" aria-hidden="true">
						<svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
					</span>
				</a>
			</div>
			<div class="video-meta">
				<b>{site.video.title}</b>
				<span>YouTube · {site.video.channel}</span>
			</div>
		</div>
	</section>

	<section class="sec audiences">
		<div class="wrap pair">
			<div class="card audience adults">
				<span class="eyebrow">For adults</span>
				<h3>Blurry text, headaches or screen strain?</h3>
				<p>If reading has become harder or your eyes feel tired after screen time, start with one of these tests.</p>
				<div class="actions small">
					<a href={routes.readingGlasses} class="btn">Reading glasses test</a>
					<a href={routes.astigmatism} class="btn">Astigmatism test</a>
				</div>
			</div>
			<div class="card audience parents">
				<span class="badge">For parents</span>
				<h3>Checking a child from age 3</h3>
				<p>Child-friendly shapes let children take part before they can read, so problems can be picked up early.</p>
				<div class="actions small">
					<a href={routes.colorBlindKids} class="btn">Kids color test</a>
					<a href={routes.lazyEye} class="btn">Lazy eye test</a>
				</div>
				<img src="/images/test-color-blind.svg" alt="" width="110" height="75" loading="lazy" />
			</div>
		</div>
	</section>

	<section class="sec band">
		<div class="wrap stats">
			<div class="card stat">
				<span class="figure">{site.peopleScreened}</span>
				<p>People screened</p>
			</div>
			<div class="card stat">
				<span class="figure">{site.peopleReferred}</span>
				<p>Referred for a full eye exam</p>
			</div>
			<div class="card stat impact">
				<img src="/images/test-visual-acuity.svg" alt="" width="130" height="89" loading="lazy" />
				<p>Used at home by families, and by schools, clinics and charity programmes.</p>
			</div>
		</div>
		<div class="wrap">
			<p class="stats-note">{site.statsNote}</p>
		</div>
	</section>

	<section class="sec">
		<div class="wrap review">
			<div class="portrait">
				<div class="ph photo">[Photo]</div>
				<img src="/images/result-check.svg" alt="" width="96" height="66" loading="lazy" />
			</div>
			<div class="review-copy">
				<span class="eyebrow">Medically reviewed</span>
				<h2>Screening, not a diagnosis</h2>
				<p>
					EyeCheck.app is a digital screening tool, not a substitute for a professional eye exam. A <b>Pass</b> suggests vision is
					within the normal range for your age. A <b>Refer</b> means you may benefit from a full eye exam by an eye care
					professional.
				</p>
				<p class="reviewed-by">Reviewed by {site.reviewer}</p>
				<div class="actions">
					<a href={routes.howWeTest} class="btn">How we test</a>
					<a href={routes.medicalReview} class="btn">Our medical reviewer</a>
				</div>
			</div>
		</div>
	</section>

	<section class="sec band">
		<div class="wrap story">
			<img src="/images/our-story.webp" alt="Vision screening session using the Children Eye Screening Book shapes cards" width="694" height="388" loading="lazy" />
			<div class="story-copy">
				<span class="eyebrow">Our story</span>
				<h2>Can someone live with a cataract and not even know it?</h2>
				<p>
					Our founder Andy was born with a cataract in his right eye. Nobody knew until a school vision screening at age 8.
					EyeCheck.app exists so problems like his are caught early, at home or at school.
				</p>
				<a href={routes.about} class="btn">Read our story</a>
			</div>
		</div>
	</section>

	<section class="sec">
		<div class="wrap stack">
			<div class="head goals-head">
				<span class="eyebrow">Global goals</span>
				<h2>Our commitment to the UN Sustainable Development Goals</h2>
				<p>EyeCheck.app promotes equal access to early eye screening for every child.</p>
			</div>
			<ul class="goals">
				{
					goals.map((g) => (
						<li>
							<img src={`/images/sdg/sdg${g.n}.png`} alt={`SDG ${g.n} icon: ${g.title}`} width="64" height="64" loading="lazy" />
							<span>
								<b>
									SDG {g.n} · {g.title}
								</b>
								<span>{g.text}</span>
							</span>
						</li>
					))
				}
			</ul>
			<p class="meta">
				SDG icons courtesy of the United Nations. Learn more at <a href="https://sdgs.un.org/goals">sdgs.un.org/goals</a>.
			</p>
		</div>
	</section>

	{
		testimonials.length > 0 && (
			<section class="sec band">
				<div class="wrap stack">
					<h2>What people say</h2>
					<div class="grid3">
						{testimonials.map((t) => (
							<figure class="card quote">
								<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M7 7h4v4c0 3-1.5 5-4 6l-.8-1.3C7.6 14.8 8.3 13.6 8.3 12H7zM14 7h4v4c0 3-1.5 5-4 6l-.8-1.3c1.4-.9 2.1-2.1 2.1-3.7H14z" />
								</svg>
								<blockquote>{t.message}</blockquote>
								<figcaption>
									<b>{t.name}</b>
									{t.role && <span>{t.role}</span>}
								</figcaption>
							</figure>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="sec">
		<div class="wrap">
			<div class="charts">
				<div class="charts-copy">
					<span class="eyebrow">Free printables</span>
					<h2>Free printable eye charts</h2>
					<p>Snellen, 10-foot, pediatric shapes and tumbling E charts as PDFs for home and school.</p>
					<a href={routes.eyeCharts} class="btn solid">Browse eye charts</a>
				</div>
				<div class="charts-art">
					<img src="/images/eye-charts.svg" alt="" width="380" height="260" loading="lazy" />
				</div>
			</div>
		</div>
	</section>

	<section class="sec band">
		<div class="wrap stack">
			<div class="head">
				<span class="eyebrow">Organisations</span>
				<h2>For schools, clinics and charities</h2>
			</div>
			<div class="orgs">
				<a href={orgs[0].href} class="card">
					<span class="ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5z"></path><path d="M6 11v5c3 2 9 2 12 0v-5"></path></svg></span>
					<h3>{orgs[0].title}</h3>
					<span class="more">{orgs[0].more} →</span>
				</a>
				<a href={orgs[1].href} class="card">
					<span class="ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3v6a4 4 0 0 0 8 0V3"></path><path d="M10 13v3a4 4 0 0 0 8 0v-2"></path><circle cx="18" cy="12" r="2"></circle></svg></span>
					<h3>{orgs[1].title}</h3>
					<span class="more">{orgs[1].more} →</span>
				</a>
				<a href={orgs[2].href} class="card">
					<span class="ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg></span>
					<h3>{orgs[2].title}</h3>
					<span class="more">{orgs[2].more} →</span>
				</a>
				<a href={orgs[3].href} class="card">
					<span class="ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3"></path></svg></span>
					<h3>{orgs[3].title}</h3>
					<span class="more">{orgs[3].more} →</span>
				</a>
			</div>
		</div>
	</section>

	<section class="sec">
		<div class="wrap stack">
			<div class="head split">
				<div class="head">
					<span class="eyebrow">Blog</span>
					<h2>From the blog</h2>
				</div>
				<a href={routes.blog} class="more">All articles →</a>
			</div>
			<div class="grid3">
				{
					posts.map((p) => (
						<a href={p.href} class="card post">
							<div class="ph">[Image]</div>
							<div class="post-body">
								<span class="meta">{p.topic}</span>
								<h3>{p.title}</h3>
								<span class="meta">Reviewed by {site.reviewer}</span>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="sec follow-sec">
		<div class="wrap">
			<div class="follow">
				<div class="follow-copy">
					<span class="eyebrow">Follow us</span>
					<h2>Eye health tips, every week</h2>
					<p>Short videos and tips on screen time, children’s vision and when to see an eye doctor.</p>
				</div>
				<div class="actions">
					{
						socialLinks.map((s) => (
							<a href={s.href || '#'} target="_blank" rel="noopener" class="btn" aria-label={`Follow EyeCheck on ${s.name}`}>
								<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d={s.icon} />
								</svg>
								{s.name}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class="sec band">
		<div class="wrap faq">
			<span class="eyebrow">FAQ</span>
			<h2>Online eye test FAQ</h2>
			{
				faqs.map((f) => (
					<details>
						<summary>
							<span>{f.q}</span>
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
						</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<section class="closing">
		<div class="wrap closing-in">
			<img src="/images/logo-on-blue.svg" alt="" width="331" height="48" loading="lazy" />
			<h2>Check your eyes now</h2>
			<p>Free, 3–4 minutes, a result for each eye.</p>
			<a href={routes.start} class="btn">
				Start free eye test
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
			</a>
		</div>
	</section>
</Layout>

<script>
	// Hero slideshow: advances every 5 seconds, pauses while hovered or focused, and stays put for reduced motion.
	const show = document.querySelector<HTMLElement>('[data-slides]');
	if (show) {
		const slides = [...show.querySelectorAll<HTMLElement>('.slide')];
		const thumbs = [...show.querySelectorAll<HTMLButtonElement>('.thumb')];
		let current = 0;
		let paused = false;
		const go = (n: number) => {
			current = (n + slides.length) % slides.length;
			slides.forEach((s, i) => s.classList.toggle('active', i === current));
			thumbs.forEach((t, i) => {
				t.classList.toggle('active', i === current);
				t.setAttribute('aria-pressed', String(i === current));
			});
		};
		thumbs.forEach((t, i) => t.addEventListener('click', () => go(i)));
		show.addEventListener('mouseenter', () => (paused = true));
		show.addEventListener('mouseleave', () => (paused = false));
		show.addEventListener('focusin', () => (paused = true));
		show.addEventListener('focusout', () => (paused = false));
		if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			window.setInterval(() => !paused && go(current + 1), 5000);
		}
	}

	// Click-to-load: the poster links to YouTube, and with JavaScript it swaps in the player on click,
	// so no YouTube script is requested until the visitor presses play.
	const video = document.querySelector<HTMLElement>('[data-video]');
	video?.querySelector('a')?.addEventListener('click', (e) => {
		e.preventDefault();
		const frame = document.createElement('iframe');
		frame.src = `https://www.youtube-nocookie.com/embed/${video.dataset.video}?autoplay=1&cc_load_policy=1&rel=0`;
		frame.title = 'How to use EyeCheck (video)';
		frame.allow = 'autoplay; encrypted-media; picture-in-picture';
		frame.allowFullscreen = true;
		video.replaceChildren(frame);
		frame.focus();
	});
</script>

<style>
	.stack {
		display: flex;
		flex-direction: column;
		gap: 32px;
