---
import AudiencePage from '../components/AudiencePage.astro';
---

<AudiencePage
	crumb="Clinics"
	h1="Vision Screening Tools for Clinics"
	intro="Perform eyesight screening at home, in your clinic or at large events."
	why={{
		title: 'Healthcare professionals',
		list: [
			'Patients run guided self-screening at home or in clinic',
			'Email secure screening links for remote follow-ups',
			'Run screening days on several laptops at once',
			'Reduce clinic appointment time; scale from one patient to hundreds',
		],
	}}
	plan={{
		label: 'Healthcare plan',
		price: 'SGD 100',
		unit: '100 eyesight screenings (SGD 1 per screening)',
		items: ['PDF report for each screening', 'Easy setup and deployment', 'No software installation', 'Training provided'],
	}}
	faq={{ title: '[FAQ heading]', questions: ['[Question 1]', '[Question 2]', '[Question 3]'] }}
	form={{
		fields: [
			{ label: 'Name', required: true },
			{ label: 'Profession (e.g. Optometrist, Nurse, Doctor)' },
			{ label: 'Email', type: 'email', required: true },
			{ label: 'Contact number', type: 'tel' },
			{ label: 'Remarks (optional)', type: 'textarea' },
		],
		button: 'Schedule an online session',
	}}
/>
